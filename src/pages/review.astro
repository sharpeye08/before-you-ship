---
// Review mode: spaced repetition over quiz questions from lessons you've completed.
// Each question sits in a "box" 1–5. Right answers move it up a box and push it further
// into the future; wrong answers send it back to box 1. Stored only in this browser.
import Reading from '../layouts/Reading.astro';
---

<Reading title="Review mode" description="A short daily review of quiz questions from lessons you've completed, spaced out so you remember them.">
  <header>
    <h1 class="page-title">Review mode</h1>
    <p class="page-intro">
      A few questions a day from lessons you've completed. Questions you get right come back later and later. Questions
      you miss come back sooner. It takes about five minutes.
    </p>
    <p class="mt-4 text-sm" data-stats>Loading…</p>
  </header>

  <section class="review card mt-10 p-6 sm:p-8" data-review aria-live="polite">
    <p>Loading questions…</p>
  </section>

  <noscript><p class="mt-6 text-center">Review mode needs JavaScript.</p></noscript>
</Reading>

<style>
  .review :global(.r-meta) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 18px;
    font-size: 0.875rem;
  }
  .review :global(.r-meta a) {
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.35);
    text-underline-offset: 3px;
  }
  .review :global(.r-meta a:hover) {
    text-decoration-color: #ffffff;
  }
  .review :global(.r-q) {
    margin: 0 0 20px;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.45;
  }
  .review :global(.r-options) {
    display: grid;
    gap: 10px;
  }
  .review :global(.r-option) {
    padding: 14px 16px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.03);
    color: #ffffff;
    font: inherit;
    line-height: 1.5;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .review :global(.r-option:hover:not(:disabled)) {
    border-color: rgb(255 255 255 / 0.4);
    background: rgb(255 255 255 / 0.08);
  }
  .review :global(.r-option:disabled) {
    cursor: default;
  }
  .review :global(.r-option.ok) {
    border-color: rgb(134 220 174 / 0.6);
    background: rgb(134 220 174 / 0.15);
  }
  .review :global(.r-option.bad) {
    border-color: rgb(242 121 123 / 0.6);
    background: rgb(242 121 123 / 0.15);
  }
  .review :global(.r-explain) {
    margin: 20px 0 0;
    padding: 16px 18px;
    border-left: 3px solid #ffffff;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.04);
    line-height: 1.7;
  }
  .review :global(.r-done) {
    font-size: 1.65rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .review :global(.r-note) {
    margin-top: 10px;
    line-height: 1.7;
  }
  .review :global(.r-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .review :global(code) {
    padding: 0.12em 0.38em;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.09);
    font-size: 0.88em;
  }
</style>

<script>
  import { getCompleted } from '../lib/progress';

  type Q = { id: string; slug: string; title: string; order: number; level: number; q: string; o: { t: string; c: boolean }[]; e: string };
  type Card = { box: number; due: number };

  const KEY = 'bys:review';
  const DAY = 86_400_000;
  const INTERVAL_DAYS = [0, 1, 2, 4, 8, 16]; // index = box
  const SESSION_SIZE = 10;

  const root = document.querySelector<HTMLElement>('[data-review]')!;
  const stats = document.querySelector<HTMLElement>('[data-stats]')!;

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const fmt = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');

  const loadCards = (): Record<string, Card> => {
    try {
      return JSON.parse(localStorage.getItem(KEY) || '{}');
    } catch {
      return {};
    }
  };
  const saveCards = (c: Record<string, Card>) => {
    try {
      localStorage.setItem(KEY, JSON.stringify(c));
    } catch {}
  };
  const shuffle = <T,>(a: T[]) => {
    const b = [...a];
    for (let i = b.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [b[i], b[j]] = [b[j], b[i]];
    }
    return b;
  };

  let all: Q[] = [];
  const completed = new Set(getCompleted());

  function dueQuestions(pool: Q[]) {
    const cards = loadCards();
    const now = Date.now();
    return pool
      .filter((q) => (cards[q.id]?.due ?? 0) <= now)
      .sort((a, b) => (cards[a.id]?.due ?? 0) - (cards[b.id]?.due ?? 0) || a.order - b.order);
  }

  function renderStats(pool: Q[]) {
    const cards = loadCards();
    const due = dueQuestions(pool).length;
    const learned = pool.filter((q) => (cards[q.id]?.box ?? 0) >= 4).length;
    stats.textContent = pool.length
      ? `${due} due now · ${learned} of ${pool.length} questions well learned`
      : 'Complete a lesson to unlock its questions.';
  }

  function start(pool: Q[]) {
    renderStats(pool);
    const session = shuffle(dueQuestions(pool).slice(0, SESSION_SIZE * 3)).slice(0, SESSION_SIZE);
    if (!session.length) return renderDone(pool, 0, 0, true);
    let i = 0;
    let right = 0;

    const show = () => {
      const q = session[i];
      root.innerHTML = `
        <div class="r-meta"><span>Question ${i + 1} of ${session.length}</span>
          <a href="/lessons/${q.slug}">From lesson ${q.order}: ${esc(q.title)}</a></div>
        <p class="r-q">${fmt(q.q)}</p>
        <div class="r-options"></div>`;
      const box = root.querySelector('.r-options')!;
      for (const o of shuffle(q.o)) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'r-option';
        b.innerHTML = fmt(o.t);
        b.addEventListener('click', () => answer(q, o.c, b));
        box.append(b);
        (b as any)._correct = o.c;
      }
    };

    const answer = (q: Q, correct: boolean, chosen: HTMLButtonElement) => {
      const buttons = [...root.querySelectorAll<HTMLButtonElement>('.r-option')];
      buttons.forEach((b) => {
        b.disabled = true;
        if ((b as any)._correct) b.classList.add('ok');
      });
      if (!correct) chosen.classList.add('bad');
      else right++;

      const cards = loadCards();
      const prev = cards[q.id]?.box ?? 0;
      const box = correct ? Math.min(prev + 1, 5) : 1;
      cards[q.id] = { box, due: Date.now() + INTERVAL_DAYS[box] * DAY };
      saveCards(cards);

      const p = document.createElement('p');
      p.className = 'r-explain';
      p.innerHTML = `<strong>${correct ? 'Correct.' : 'Not quite.'}</strong> ${fmt(q.e)}`;
      const actions = document.createElement('div');
      actions.className = 'r-actions';
      const next = document.createElement('button');
      next.type = 'button';
      next.className = 'btn btn-light';
      next.textContent = i + 1 < session.length ? 'Next question' : 'Finish';
      next.addEventListener('click', () => {
        i++;
        if (i < session.length) show();
        else renderDone(pool, right, session.length, false);
      });
      actions.append(next);
      root.append(p, actions);
      next.focus();
    };

    show();
  }

  function renderDone(pool: Q[], right: number, total: number, nothingDue: boolean) {
    renderStats(pool);
    const cards = loadCards();
    const nextDue = pool
      .map((q) => cards[q.id]?.due)
      .filter((d): d is number => !!d && d > Date.now())
      .sort((a, b) => a - b)[0];
    const when = nextDue ? new Date(nextDue).toLocaleDateString(undefined, { weekday: 'long', month: 'short', day: 'numeric' }) : null;
    root.innerHTML = `
      <h2 class="r-done">${nothingDue ? 'Nothing to review right now' : `Done: ${right} of ${total} correct`}</h2>
      <p class="r-note">${when ? `Your next questions are due on ${when}.` : 'Complete more lessons to add questions.'}</p>
      <div class="r-actions">
        <a class="btn btn-light" href="/lessons">Continue the lessons</a>
        ${pool.length ? '<button type="button" class="btn btn-ghost" data-extra>Practice 10 more anyway</button>' : ''}
      </div>`;
    root.querySelector('[data-extra]')?.addEventListener('click', () => {
      // Extra practice: questions that aren't due yet, weakest first. Still updates their boxes.
      const cards = loadCards();
      const extra = [...pool].sort((a, b) => (cards[a.id]?.box ?? 0) - (cards[b.id]?.box ?? 0)).slice(0, 10);
      extra.forEach((q) => (cards[q.id] = { box: cards[q.id]?.box ?? 0, due: 0 }));
      saveCards(cards);
      start(pool);
    });
  }

  function init() {
    const pool = all.filter((q) => completed.has(q.slug));
    if (pool.length) return start(pool);
    renderStats(pool);
    root.innerHTML = `
      <h2 class="r-done">No questions yet</h2>
      <p class="r-note">Review mode uses questions from lessons you've marked as completed. Finish a lesson, then come back.</p>
      <div class="r-actions">
        <a class="btn btn-light" href="/lessons/what-happens-when-you-open-a-website">Start lesson 1</a>
        <button type="button" class="btn btn-ghost" data-all>Try it with every lesson</button>
      </div>`;
    root.querySelector('[data-all]')!.addEventListener('click', () => start(all));
  }

  fetch('/review-data.json')
    .then((r) => r.json())
    .then((data: Q[]) => {
      all = data;
      init();
    })
    .catch(() => {
      root.innerHTML = '<p>Couldn\'t load the questions. Check your connection and reload.</p>';
      stats.textContent = '';
    });
</script>
