---
import Reading from '../../layouts/Reading.astro';
import Icon from '../../components/Icon.astro';
import Search from '../../components/Search.astro';
import { getSummaries, groupByLevel } from '../../lib/lessons';

const lessons = await getSummaries();
const levels = groupByLevel(lessons);
---

<Reading title="All lessons" width="wide">
  <header>
    <h1 class="page-title">All lessons</h1>
    <p class="page-intro max-w-[62ch]">
      {lessons.length} lessons in {levels.length} levels, easiest first. Each one takes about 10–15 minutes. Start at the top,
      <a href="/start" class="underline decoration-white/35 underline-offset-4 hover:decoration-white">take the placement test</a>, or jump to what you need.
    </p>

    <div class="mt-10">
      <div class="mb-2 flex items-baseline justify-between text-sm">
        <span class="font-medium">Your progress</span>
        <span class="tabular-nums" data-overall>0 / {lessons.length}</span>
      </div>
      <div class="h-1 overflow-hidden rounded-full bg-white/10">
        <div class="h-full w-0 rounded-full bg-mint transition-[width] duration-500" data-overall-fill></div>
      </div>
    </div>

    <div class="mt-8">
      <Search lessons={lessons} mode="filter" placeholder="Filter lessons: DNS, git, login, CORS…" />
    </div>
  </header>

  <p class="mt-10" data-search-empty hidden>No lessons match that. Try a different word.</p>

  {
    levels.map((level) => (
      <section class="mt-16 scroll-mt-24" id={`level-${level.n}`} data-level-section>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
          <div>
            <h2 class="text-[1.65rem] leading-tight font-medium tracking-[-0.02em]">
              Level {level.n}: {level.name}
            </h2>
            <p class="mt-2 max-w-[60ch]">{level.blurb}</p>
          </div>
          <span
            class="flex-none self-start rounded-full border border-line px-3 py-1 text-sm tabular-nums"
            data-level-count={JSON.stringify(level.lessons.map((l) => l.slug))}
          >
            {level.lessons.length} lessons
          </span>
        </div>
        {level.lessons.length === 0 ? (
          <p class="mt-6">Lessons for this level are being written.</p>
        ) : (
          <ul class="mt-6 border-t border-line">
            {level.lessons.map((l) => (
              <li class="border-b border-line" data-search={`${l.title} ${l.concepts.join(' ')} ${l.levelName}`}>
                <a class="group flex items-center gap-4 px-1 py-4" href={`/lessons/${l.slug}`} data-row={l.slug}>
                  <span class="grid size-8 flex-none place-items-center rounded-full border border-line text-sm font-semibold tabular-nums group-[.is-done]:border-mint group-[.is-done]:bg-mint group-[.is-done]:text-[#0b0b0b]">
                    <span class="group-[.is-done]:hidden">{l.order}</span>
                    <span class="hidden group-[.is-done]:block">
                      <Icon name="check" size={16} />
                    </span>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-[1.08rem] font-medium underline-offset-4 group-hover:underline" data-row-title>
                      {l.title}
                    </span>
                    <span class="mt-0.5 block truncate text-sm">{l.concepts.join(' · ')}</span>
                  </span>
                  <span class="hidden flex-none text-sm sm:block">{l.minutes} min</span>
                  <Icon name="chevron-right" size={18} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</Reading>

<script>
  import { getCompleted } from '../../lib/progress';
  const done = new Set(getCompleted());
  const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
  let count = 0;
  for (const row of rows) {
    if (done.has(row.dataset.row!)) {
      row.classList.add('is-done');
      row.setAttribute('aria-label', `${row.querySelector('[data-row-title]')?.textContent?.trim()} (completed)`);
      count++;
    }
  }
  document.querySelector('[data-overall]')!.textContent = `${count} / ${rows.length}`;
  document.querySelector<HTMLElement>('[data-overall-fill]')!.style.width = `${(count / Math.max(rows.length, 1)) * 100}%`;
  document.querySelectorAll<HTMLElement>('[data-level-count]').forEach((el) => {
    const slugs: string[] = JSON.parse(el.dataset.levelCount || '[]');
    const n = slugs.filter((s) => done.has(s)).length;
    if (n) el.textContent = `${n} / ${slugs.length} done`;
  });
</script>
