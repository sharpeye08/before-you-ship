---
// Lesson pages now toggle "Mark as completed" in place; this page stays for old links. Cloudflare Web Analytics counts views of these pages,
// which gives lesson-completion numbers without custom events.
import Reading from '../../../layouts/Reading.astro';
import Icon from '../../../components/Icon.astro';
import { getLessons, summarize } from '../../../lib/lessons';

export async function getStaticPaths() {
  const lessons = (await getLessons()).map(summarize);
  return lessons.map((lesson, i) => ({
    params: { slug: lesson.slug },
    props: { lesson, next: lessons[i + 1] ?? null, all: lessons.map((l) => l.slug) },
  }));
}

const { lesson, next, all } = Astro.props;
---

<Reading title={`Completed: ${lesson.title}`}>
  <section class="pt-[6vh] text-center">
    <div class="mx-auto mb-6 grid size-16 place-items-center rounded-full bg-mint/15 text-mint"><Icon name="check" size={30} /></div>
    <p class="font-medium">Lesson {lesson.order} complete</p>
    <h1 class="page-title mt-3">{lesson.title}</h1>

    <div class="card mt-10 p-6 text-left">
      <div class="mb-3 flex justify-between text-sm">
        <span>Your progress</span>
        <span data-count data-all={JSON.stringify(all)}>–</span>
      </div>
      <div class="h-1 overflow-hidden rounded-full bg-white/14"><div class="h-full w-0 bg-mint transition-[width] duration-400" data-fill></div></div>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      {
        next ? (
          <a class="btn btn-light h-auto min-h-[46px] py-2.5" href={`/lessons/${next.slug}`}>
            Next: {next.title} <Icon name="arrow-right" size={18} />
          </a>
        ) : (
          <p class="w-full">That was the last lesson. You've finished the whole course.</p>
        )
      }
      <a class="btn btn-ghost" href="/lessons">All lessons</a>
    </div>
    <p class="mt-8 text-sm">Progress is saved only in this browser.</p>
  </section>
</Reading>

<script>
  import { getCompleted } from '../../../lib/progress';
  const el = document.querySelector<HTMLElement>('[data-count]')!;
  const all: string[] = JSON.parse(el.dataset.all || '[]');
  const done = getCompleted().filter((s) => all.includes(s)).length;
  el.textContent = `${done} / ${all.length} lessons`;
  document.querySelector<HTMLElement>('[data-fill]')!.style.width = `${(done / Math.max(all.length, 1)) * 100}%`;
</script>
