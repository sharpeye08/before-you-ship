---
// Opened by "Mark as completed". Cloudflare Web Analytics counts views of these pages,
// which gives lesson-completion numbers without custom events.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { getLessons, summarize } from '../../../lib/lessons';

export async function getStaticPaths() {
  const lessons = (await getLessons()).map(summarize);
  return lessons.map((lesson, i) => ({
    params: { slug: lesson.slug },
    props: { lesson, next: lessons[i + 1] ?? null, all: lessons.map((l) => l.slug) },
  }));
}

const { lesson, next, all } = Astro.props;
---

<Base title={`Completed: ${lesson.title}`} active="lessons">
  <section class="done glass">
    <div class="done-icon"><Icon name="check" size={34} /></div>
    <p class="done-kicker">Lesson {lesson.order} complete</p>
    <h1>{lesson.title}</h1>

    <div class="done-progress">
      <div class="done-progress-label">
        <span>Your progress</span>
        <span data-count data-all={JSON.stringify(all)}>–</span>
      </div>
      <div class="progress-track"><div class="progress-fill" data-fill></div></div>
    </div>

    <div class="done-actions">
      {
        next ? (
          <a class="btn btn-accent" href={`/lessons/${next.slug}`}>
            Next: {next.title} <Icon name="arrow-right" size={18} />
          </a>
        ) : (
          <p class="muted">That was the last lesson. You've finished the whole course.</p>
        )
      }
      <a class="btn" href="/lessons">All lessons</a>
    </div>
    <p class="muted small">Progress is saved only in this browser.</p>
  </section>
</Base>

<style>
  .done {
    max-width: 620px;
    margin: 8vh auto 0;
    padding: 44px 36px;
    text-align: center;
  }
  .done-icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin: 0 auto 18px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 40px rgba(229, 72, 77, 0.45);
  }
  .done-kicker {
    margin: 0 0 6px;
    color: var(--accent-text);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  h1 {
    margin: 0 0 28px;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.2;
  }
  .done-progress {
    text-align: left;
    margin-bottom: 28px;
  }
  .done-progress-label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .done-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .small {
    margin: 20px 0 0;
    font-size: 0.82rem;
  }
  @media (max-width: 760px) {
    .done {
      padding: 32px 20px;
    }
  }
</style>

<script>
  import { getCompleted } from '../../../lib/progress';
  const el = document.querySelector<HTMLElement>('[data-count]')!;
  const all: string[] = JSON.parse(el.dataset.all || '[]');
  const done = getCompleted().filter((s) => all.includes(s)).length;
  el.textContent = `${done} / ${all.length} lessons`;
  document.querySelector<HTMLElement>('[data-fill]')!.style.width = `${(done / Math.max(all.length, 1)) * 100}%`;
</script>
