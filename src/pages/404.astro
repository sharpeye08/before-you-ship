---
import Editorial from '../layouts/Editorial.astro';
import Icon from '../components/Icon.astro';
---

<Editorial title="Page not found">
  <section class="nf glass">
    <p class="code">404</p>
    <h1>This page doesn't exist</h1>
    <p class="muted">
      The server got your request and answered, but there's nothing at this address. Maybe a typo, or a lesson that
      moved.
    </p>
    <div class="actions">
      <a class="btn btn-accent" href="/lessons"><Icon name="book" size={18} /> All lessons</a>
      <a class="btn" href="/">Home</a>
    </div>
  </section>
</Editorial>

<style>
  .nf {
    max-width: 560px;
    margin: 12vh auto 0;
    padding: 40px 32px;
    text-align: center;
  }
  .code {
    margin: 0;
    font-size: 4.5rem;
    font-weight: 200;
    letter-spacing: -0.03em;
    color: var(--accent-text);
  }
  h1 {
    margin: 0 0 10px;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }
</style>
