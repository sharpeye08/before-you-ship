---
import Reading from '../layouts/Reading.astro';
import Icon from '../components/Icon.astro';
---

<Reading title="Page not found">
  <section class="pt-[10vh] text-center">
    <p class="text-[4.5rem] leading-none font-extralight tracking-[-0.03em]">404</p>
    <h1 class="page-title mt-6">This page doesn't exist</h1>
    <p class="page-intro mx-auto max-w-[52ch]">
      The server got your request and answered, but there's nothing at this address. Maybe a typo, or a lesson that
      moved.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a class="btn btn-light" href="/lessons"><Icon name="book" size={18} /> All lessons</a>
      <a class="btn btn-ghost" href="/">Home</a>
    </div>
  </section>
</Reading>
