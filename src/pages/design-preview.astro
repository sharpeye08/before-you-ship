---
// Design prototype only: one real lesson in an editorial style (big headline, illustration,
// left metadata column). Doesn't use the site layout, so it doesn't affect any other page.
import { getEntry, render } from 'astro:content';
import { summarize, getLessons } from '../lib/lessons';

const lesson = (await getEntry('lessons', 'logged-in-doesnt-mean-allowed'))!;
const { Content } = await render(lesson);
const info = summarize(lesson);
const total = (await getLessons()).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design preview · {info.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="frame">
      <header class="top">
        <a class="logo" href="/">before<span>/</span>you<span>/</span>ship</a>
        <nav>
          <a href="/lessons">All lessons <span aria-hidden="true">↗</span></a>
          <a href="#" class="menu">Menu <span class="dot" aria-hidden="true"></span></a>
        </nav>
      </header>

      <a class="back" href={`/lessons#level-${info.level}`}><span aria-hidden="true">↖</span> Back to Level {info.level} · {info.levelName}</a>
      <h1>{info.title}</h1>

      <figure class="hero" aria-label="Illustration: one invoice page, many invoices behind it">
        <svg viewBox="0 0 1000 380" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true">
          <defs>
            <pattern id="grain" width="6" height="6" patternUnits="userSpaceOnUse">
              <circle cx="1" cy="1" r="0.6" fill="#000" opacity="0.08" />
              <circle cx="4" cy="4" r="0.5" fill="#000" opacity="0.06" />
            </pattern>
          </defs>
          <rect width="1000" height="380" fill="#f1e6cf" />
          <!-- background invoices -->
          <g>
            <rect x="560" y="60" width="150" height="190" rx="10" fill="#4f6bd8" transform="rotate(8 635 155)" />
            <rect x="660" y="80" width="150" height="190" rx="10" fill="#f2c94c" transform="rotate(-6 735 175)" />
            <rect x="760" y="50" width="150" height="190" rx="10" fill="#e98da4" transform="rotate(10 835 145)" />
            <rect x="840" y="120" width="150" height="190" rx="10" fill="#1f9d6b" transform="rotate(-9 915 215)" />
          </g>
          <!-- browser window -->
          <g transform="translate(70 50)">
            <rect width="470" height="290" rx="16" fill="#151515" />
            <circle cx="24" cy="24" r="6" fill="#e98da4" />
            <circle cx="44" cy="24" r="6" fill="#f2c94c" />
            <circle cx="64" cy="24" r="6" fill="#1f9d6b" />
            <rect x="90" y="12" width="360" height="24" rx="12" fill="#2a2a2a" />
            <text x="106" y="29" font-family="Inter, sans-serif" font-size="14" fill="#cfcfcf">myapp.com/invoices/</text>
            <rect x="248" y="14" width="44" height="20" rx="6" fill="#f2c94c" />
            <text x="254" y="29" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#151515">1041</text>
            <rect x="24" y="60" width="422" height="206" rx="10" fill="#f1e6cf" />
            <rect x="44" y="80" width="140" height="16" rx="8" fill="#151515" />
            <rect x="44" y="110" width="260" height="10" rx="5" fill="#151515" opacity="0.35" />
            <rect x="44" y="130" width="220" height="10" rx="5" fill="#151515" opacity="0.35" />
            <rect x="44" y="150" width="240" height="10" rx="5" fill="#151515" opacity="0.35" />
            <rect x="44" y="200" width="120" height="40" rx="8" fill="#4f6bd8" />
            <text x="62" y="226" font-family="Inter, sans-serif" font-size="15" font-weight="600" fill="#fff">$2,480</text>
            <text x="300" y="232" font-family="Inter, sans-serif" font-size="13" fill="#151515" opacity="0.6">not yours</text>
          </g>
          <!-- cursor -->
          <path d="M320 70 l0 46 l12 -12 l9 20 l9 -4 l-9 -20 l17 0 Z" fill="#151515" stroke="#fff" stroke-width="2" />
          <rect width="1000" height="380" fill="url(#grain)" />
        </svg>
      </figure>

      <div class="body">
        <aside class="meta">
          <div class="who">
            <span class="badge">{info.order}</span>
            <div>
              <strong>Lesson {info.order} of {total}</strong>
              <span>Level {info.level} · {info.levelName}</span>
            </div>
          </div>
          <p class="read"><b>{info.minutes} MIN</b> read in <span class="chip">Security</span></p>
          <ul class="tags">
            {info.concepts.map((c) => <li>{c}</li>)}
          </ul>
          <div class="actions">
            <button type="button">✓ Mark as completed</button>
            <a href="#">Report a mistake</a>
          </div>
        </aside>

        <article class="prose">
          <Content />
        </article>
      </div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0c0c0c;
    --frame: #050505;
    --text: #f2f2f2;
    --soft: #c9c9c9;
    --muted: #8a8a8a;
    --line: rgba(255, 255, 255, 0.12);
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  .frame {
    max-width: 1140px;
    margin: 40px auto;
    padding: 36px 64px 80px;
    background: var(--frame);
    border-radius: 6px;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 6px 6px;
    background-position: 0 0;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 72px;
  }
  .logo {
    text-decoration: none;
    font-family: 'Inter Tight', sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .logo span {
    color: var(--muted);
  }
  .top nav {
    display: flex;
    gap: 28px;
    font-size: 0.95rem;
  }
  .top nav a {
    text-decoration: none;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 8px;
    border-radius: 50%;
    background: var(--text);
  }
  .back {
    display: inline-flex;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--soft);
    text-decoration: none;
  }
  h1 {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 500;
    font-size: clamp(2.2rem, 5.2vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 14px 0 56px;
    max-width: 18ch;
  }
  .hero {
    margin: 0 0 64px;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 1000 / 380;
  }
  .hero svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .body {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    gap: 72px;
    align-items: start;
  }
  .meta {
    position: sticky;
    top: 24px;
    font-size: 0.82rem;
    color: var(--soft);
  }
  .who {
    display: flex;
    gap: 12px;
    align-items: center;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .who strong {
    display: block;
    color: var(--text);
    font-weight: 500;
  }
  .who span {
    color: var(--muted);
  }
  .badge {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #f2c94c;
    color: #111;
    font-weight: 600;
  }
  .read b {
    color: var(--text);
    font-weight: 600;
  }
  .chip {
    display: inline-block;
    margin-left: 4px;
    padding: 3px 10px;
    border: 1px solid var(--soft);
    border-radius: 99px;
    color: var(--text);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 14px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    padding: 2px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--soft);
  }
  .actions {
    display: grid;
    gap: 8px;
    margin-top: 18px;
  }
  .actions button {
    font: inherit;
    padding: 9px 12px;
    border-radius: 99px;
    border: 0;
    background: var(--text);
    color: #111;
    font-weight: 600;
    cursor: pointer;
  }
  .actions a {
    color: var(--muted);
    font-size: 0.8rem;
  }

  /* Article */
  .prose {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--soft);
    max-width: 68ch;
  }
  .prose h1 {
    display: none;
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose h2 {
    font-family: 'Inter Tight', sans-serif;
    font-weight: 500;
    font-size: 2.2rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 2.2em 0 0.6em;
  }
  .prose h3 {
    color: var(--text);
    font-size: 1.25rem;
    margin: 1.8em 0 0.5em;
  }
  .prose strong {
    color: var(--text);
  }
  .prose a {
    color: var(--text);
    text-underline-offset: 3px;
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 3em 0;
  }
  .prose blockquote {
    margin: 1.6em 0;
    padding: 2px 0 2px 18px;
    border-left: 3px solid var(--text);
    color: var(--text);
    font-size: 1.22rem;
    line-height: 1.55;
  }
  .prose blockquote p {
    margin: 0.4em 0;
  }
  .prose .callout-start {
    border-left-color: #f2c94c;
    font-size: 1rem;
    color: var(--soft);
  }
  .prose .callout-deeper {
    font-size: 0.98rem;
    border-left-color: #4f6bd8;
    color: var(--soft);
  }
  .prose code {
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.86em;
    background: rgba(255, 255, 255, 0.07);
    padding: 0.1em 0.35em;
    border-radius: 5px;
    color: var(--text);
  }
  .prose pre {
    padding: 18px 20px;
    border-radius: 12px;
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose .table-wrap {
    overflow-x: auto;
  }
  .prose table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.95rem;
  }
  .prose th,
  .prose td {
    border-bottom: 1px solid var(--line);
    padding: 10px 12px;
    text-align: left;
  }
  .prose details {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
    margin-top: 2em;
  }
  .prose summary {
    cursor: pointer;
    color: var(--text);
  }

  @media (max-width: 860px) {
    .frame {
      margin: 0;
      padding: 20px 18px 60px;
      border-radius: 0;
    }
    .top {
      margin-bottom: 40px;
    }
    .top nav a:first-child {
      display: none;
    }
    h1 {
      margin-bottom: 28px;
    }
    .hero {
      margin-bottom: 28px;
      border-radius: 14px;
    }
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .meta {
      position: static;
    }
    .actions {
      grid-template-columns: auto auto;
      justify-content: start;
      align-items: center;
    }
    .prose {
      font-size: 1.04rem;
    }
    .prose h2 {
      font-size: 1.7rem;
    }
  }
</style>
