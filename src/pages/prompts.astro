---
// Prompt library: every "Ask your AI" prompt from every lesson, grouped by level, with copy buttons.
import Reading from '../layouts/Reading.astro';
import Icon from '../components/Icon.astro';
import { getLessons } from '../lib/lessons';
import { extract, plain } from '../lib/extract';
import { LEVELS } from '../config';

const lessons = await getLessons();
const { prompts } = extract(lessons);
const groups = LEVELS.map((lv) => {
  const inLevel = prompts.filter((p) => p.level === lv.n);
  const bySlug = new Map<string, typeof inLevel>();
  for (const p of inLevel) bySlug.set(p.slug, [...(bySlug.get(p.slug) ?? []), p]);
  return { ...lv, lessons: [...bySlug.values()] };
}).filter((g) => g.lessons.length);
---

<Reading title="Prompt library" description="Every 'Ask your AI' prompt from every lesson, ready to copy into your AI tool." width="wide">
  <header>
    <h1 class="page-title">Prompt library</h1>
    <p class="page-intro max-w-[680px]">
      Questions to paste into your AI tool to check your own app, collected from every lesson. Replace anything in
      [square brackets] with your details.
    </p>
    <p class="mt-3 text-sm">{prompts.length} prompts</p>
    <label class="mt-8 flex max-w-[520px] items-center gap-3 rounded-full border border-line bg-white/4 px-4 py-3 focus-within:border-white/50">
      <Icon name="search" size={18} />
      <input type="search" class="w-full bg-transparent outline-none placeholder:text-white" placeholder="Find a prompt: secrets, cache, login…" autocomplete="off" data-pl-filter aria-label="Filter prompts" />
    </label>
  </header>

  <p class="mt-10" data-pl-empty hidden>No prompts match that.</p>

  {
    groups.map((g) => (
      <section class="mt-16 border-t border-line pt-10" data-pl-section>
        <h2 class="text-[1.65rem] leading-tight font-medium tracking-[-0.02em]">Level {g.n}: {g.name}</h2>
        {g.lessons.map((items) => (
          <div class="mt-8" data-pl-group>
            <h3 class="h3">
              <a class="hover:underline" href={`/lessons/${items[0].slug}`}>
                {items[0].order}. {items[0].title}
              </a>
            </h3>
            <ul class="mt-3 grid gap-2">
              {items.map((p) => (
                <li class="card flex items-start justify-between gap-4 px-4 py-3" data-pl={plain(p.text).toLowerCase()}>
                  <p class="min-w-0 leading-relaxed [overflow-wrap:anywhere]">{plain(p.text)}</p>
                  <button type="button" class="inline-flex flex-none items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-sm hover:bg-white/8" data-copy={plain(p.text)}>
                    <Icon name="copy" size={14} /> <span>Copy</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }
</Reading>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('span')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Failed';
      }
      setTimeout(() => (label.textContent = 'Copy'), 1500);
    });
  });

  const input = document.querySelector<HTMLInputElement>('[data-pl-filter]')!;
  const empty = document.querySelector<HTMLElement>('[data-pl-empty]')!;
  input.addEventListener('input', () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-pl]').forEach((li) => {
      const hit = words.every((w) => li.dataset.pl!.includes(w));
      li.hidden = !hit;
      if (hit) shown++;
    });
    document.querySelectorAll<HTMLElement>('[data-pl-group]').forEach((g) => {
      g.hidden = !g.querySelector('[data-pl]:not([hidden])');
    });
    document.querySelectorAll<HTMLElement>('[data-pl-section]').forEach((s) => {
      s.hidden = !s.querySelector('[data-pl-group]:not([hidden])');
    });
    empty.hidden = shown > 0;
  });
</script>
