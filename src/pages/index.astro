---
// Home page in the editorial theme used by lesson pages.
import Editorial from '../layouts/Editorial.astro';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import PrismHero from '../components/PrismHero.astro';
import { getSummaries, groupByLevel } from '../lib/lessons';
import { LEVEL_COLORS } from '../config';

const lessons = await getSummaries();
const levels = groupByLevel(lessons);
const hours = Math.round(lessons.reduce((sum, l) => sum + l.minutes, 0) / 60);
const first = lessons[0];
const clientIndex = lessons.map((l) => ({ s: l.slug, t: l.title, n: l.order }));

const tools = [
  { href: '/start', title: 'Where should I start?', text: '15 questions that suggest your first lesson.' },
  { href: '/checklist', title: 'Pre-ship checklist', text: 'Every red flag from every lesson, in one list.' },
  { href: '/review', title: 'Review mode', text: 'A few quiz questions a day, so you remember.' },
  { href: '/glossary', title: 'Glossary', text: 'Every key term in plain English.' },
  { href: '/prompts', title: 'Prompt library', text: 'Questions to paste into your AI tool.' },
];
---

<Editorial title="Know what you're building" description="Free, no-login lessons on the software fundamentals behind every app, from your first website to production.">
  <PrismHero scroll />
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="kicker">{lessons.length} free lessons · {levels.length} levels · no login</p>
      <h1 id="hero-title">Know what you're building.</h1>
      <p class="lede">
        Short, plain-English lessons on how software really works: the web, databases, security, and running apps for
        real users. Made for people who build with AI.
      </p>
      <div class="hero-actions">
        {first && <a class="btn btn-accent" href={`/lessons/${first.slug}`}>Start with lesson 1</a>}
        <a class="btn" href="/start">Where should I start?</a>
      </div>
    </div>
  </section>

  <section class="story" aria-label="The five levels">
    {
      levels.map((lv) => (
        <div class="story-step" data-story-level={lv.n}>
          <div class="story-card">
            <p class="story-kicker">
              <span class="dot" style={`background:${LEVEL_COLORS[lv.n]}`} />
              Level {lv.n} of {levels.length}
            </p>
            <h2>{lv.name}</h2>
            <p class="story-text">{lv.blurb}</p>
            <a class="story-link" href={`/lessons#level-${lv.n}`}>
              {lv.lessons.length} lessons <Icon name="chevron-right" size={16} />
            </a>
          </div>
        </div>
      ))
    }
  </section>

  <p class="level-chip" data-level-chip hidden aria-hidden="true"><span class="dot" data-chip-dot></span><span data-chip-text></span></p>
  <script type="application/json" data-story-levels set:html={JSON.stringify(levels.map((l) => ({ n: l.n, name: l.name, c: LEVEL_COLORS[l.n] })))} />

  <div class="after">

  <div class="search-row">
    <Search lessons={lessons} />
  </div>

  <p class="continue" data-continue hidden></p>

  <section class="grid" aria-labelledby="course-title">
    <aside class="side">
      <h2 id="course-title">The course</h2>
      <p class="muted">
        {lessons.length} lessons, about {hours} hours in total. Each lesson takes 10 to 15 minutes and ends with a short quiz.
        Start at Level 1, or jump to what you need.
      </p>
      <p class="progress-line muted" data-progress>Completed 0 of {lessons.length}</p>
      <div class="bar"><div class="bar-fill" data-progress-fill></div></div>
    </aside>

    <ol class="levels">
      {
        levels.map((lv) => (
          <li>
            <a href={`/lessons#level-${lv.n}`}>
              <span class="lv-badge" style={`background:${LEVEL_COLORS[lv.n]}`}>
                {lv.n}
              </span>
              <span class="lv-main">
                <span class="lv-name">{lv.name}</span>
                <span class="lv-blurb">{lv.blurb}</span>
              </span>
              <span class="lv-count">{lv.lessons.length} lessons <Icon name="chevron-right" size={16} /></span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="tools" aria-labelledby="tools-title">
    <h2 id="tools-title">Tools</h2>
    <ul>
      {
        tools.map((t) => (
          <li>
            <a href={t.href}>
              <span class="t-title">{t.title} <Icon name="arrow-right" size={16} /></span>
              <span class="t-text">{t.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <script type="application/json" data-home-index set:html={JSON.stringify(clientIndex)} />
  </div>
</Editorial>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding-bottom: 7vh;
    width: 100vw;
    height: 100svh;
    min-height: 560px;
    margin-left: calc(50% - 50vw);
    margin-top: calc(-1 * (var(--pad-top) + var(--top-h) + var(--top-gap)));
    margin-bottom: 56px;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 56%, rgba(0, 0, 0, 0.85) 70%, #050505 100%);
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: calc(1440px + 2 * var(--pad-x));
    margin: 0 auto;
    padding: 0 var(--pad-x);
    text-align: center;
  }
  .kicker {
    margin: 0 0 14px;
    font-size: 0.85rem;
    color: var(--text-soft);
    letter-spacing: 0.02em;
  }
  h1 {
    font-family: 'Inter Tight', Inter, sans-serif;
    font-weight: 500;
    font-size: clamp(2.8rem, 6.4vw, 5.6rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 auto 18px;
  }
  .lede {
    margin: 0 auto 28px;
    max-width: 52ch;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-soft);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .story {
    position: relative;
    z-index: 1;
  }
  .story-step {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 100svh;
    padding-bottom: 9vh;
  }
  .story-card {
    max-width: 560px;
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-align: center;
  }
  .story-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .story-card h2 {
    margin: 0 0 10px;
    font-size: clamp(2rem, 5vw, 3.2rem);
  }
  .story-text {
    margin: 0 0 16px;
    color: var(--text-soft);
    line-height: 1.6;
  }
  .story-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.92rem;
  }
  .level-chip {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: rgba(20, 20, 20, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.82rem;
    color: var(--text-soft);
  }
  .level-chip[hidden] {
    display: none;
  }
  .after {
    position: relative;
    z-index: 1;
    margin: 0 calc(50% - 50vw);
    padding: 72px max(var(--pad-x), calc(50vw - 720px)) 0;
    background-color: var(--frame);
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 6px 6px;
    padding-bottom: 72px;
  }
  :global(.foot) {
    margin-top: 0 !important;
  }
  .search-row {
    max-width: 640px;
    margin: 0 0 14px;
  }
  .continue {
    margin: 0 0 8px;
    font-size: 0.92rem;
    color: var(--text-soft);
  }
  .continue :global(a) {
    color: var(--text);
  }
  .grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 72px;
    margin-top: 72px;
    align-items: start;
  }
  h2 {
    font-family: 'Inter Tight', Inter, sans-serif;
    font-weight: 500;
    font-size: 2rem;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .side p {
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .progress-line {
    margin: 20px 0 8px;
  }
  .bar {
    height: 3px;
    background: var(--line);
    border-radius: 99px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 0;
    background: var(--text);
  }
  .levels {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .levels a {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .levels a:hover .lv-name {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .lv-badge {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #111;
    font-weight: 600;
  }
  .lv-name {
    display: block;
    font-family: 'Inter Tight', Inter, sans-serif;
    font-size: 1.35rem;
    font-weight: 500;
  }
  .lv-blurb {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .lv-count {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-soft);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .tools {
    margin-top: 72px;
  }
  .tools ul {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .tools a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
  }
  .tools a:hover {
    border-color: var(--border-strong);
  }
  .t-title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .t-text {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Search component styles in this theme */
  .search-row :global(.search) {
    position: relative;
  }
  .search-row :global(.search-box) {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    padding: 0 18px;
    border: 1px solid var(--border-strong);
    border-radius: 99px;
  }
  .search-row :global(.search-box input) {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text);
    font: inherit;
  }
  .search-row :global(.search-box input::placeholder) {
    color: var(--muted);
  }
  .search-row :global(.kbd) {
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .search-row :global(.search-results) {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 30;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: #141414;
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .search-row :global(.search-results a) {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
  }
  .search-row :global(.search-results a:hover),
  .search-row :global(.search-results a[aria-selected='true']) {
    background: var(--glass-hover);
  }
  .search-row :global(.row-num) {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--row);
    font-size: 0.78rem;
  }
  .search-row :global(.row-title) {
    display: block;
  }
  .search-row :global(.row-sub) {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .search-row :global(.search-empty) {
    padding: 10px 12px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .hero {
      padding-bottom: 56px;
    }
    .hero-shade {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0) 46%, rgba(0, 0, 0, 0.9) 58%, #050505 100%);
    }
    .hero h1 {
      font-size: clamp(2.4rem, 11vw, 3.2rem);
      margin-bottom: 14px;
    }
    .lede {
      font-size: 1rem;
      margin-bottom: 22px;
    }
    .hero-actions .btn {
      flex: 1 1 auto;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-top: 48px;
    }
    .levels a {
      grid-template-columns: 36px minmax(0, 1fr);
    }
    .lv-count {
      grid-column: 2;
    }
    .tools {
      margin-top: 48px;
    }
  }
</style>

<script>
  import { getCompleted, getRecent } from '../lib/progress';

  type Entry = { s: string; t: string; n: number };
  const index: Entry[] = JSON.parse(document.querySelector('[data-home-index]')!.textContent || '[]');
  const bySlug = new Map(index.map((e) => [e.s, e]));
  const done = new Set(getCompleted().filter((s) => bySlug.has(s)));

  document.querySelector('[data-progress]')!.textContent = `Completed ${done.size} of ${index.length}`;
  document.querySelector<HTMLElement>('[data-progress-fill]')!.style.width = `${(done.size / Math.max(index.length, 1)) * 100}%`;

  // "Continue" line: the last unfinished lesson you opened, or the next one in order.
  const recent = getRecent().find((r) => bySlug.has(r.slug) && !done.has(r.slug));
  const target = recent ? bySlug.get(recent.slug)! : done.size ? index.find((e) => !done.has(e.s)) : undefined;
  const line = document.querySelector<HTMLElement>('[data-continue]')!;
  if (target) {
    line.textContent = recent ? 'Continue reading: ' : 'Up next: ';
    const a = document.createElement('a');
    a.href = `/lessons/${target.s}`;
    a.textContent = `Lesson ${target.n}. ${target.t}`;
    line.append(a);
    line.hidden = false;
  }

  // Scroll story: each level section lights its colour in the prism and updates the chip.
  {
    const steps = [...document.querySelectorAll<HTMLElement>('[data-story-level]')];
    const chip = document.querySelector<HTMLElement>('[data-level-chip]')!;
    const chipText = document.querySelector<HTMLElement>('[data-chip-text]')!;
    const chipDot = document.querySelector<HTMLElement>('[data-chip-dot]')!;
    const info: { n: number; name: string; c: string }[] = JSON.parse(
      document.querySelector('[data-story-levels]')!.textContent || '[]',
    );
    const update = () => {
      const vh = window.innerHeight;
      let p = 0;
      let current = 0;
      steps.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        p += Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (vh * 0.5)));
        if (r.top < vh * 0.6 && r.bottom > vh * 0.4) current = i + 1;
      });
      (window as unknown as { __prismProgress?: number }).__prismProgress = p;
      window.dispatchEvent(new Event('prism:progress'));
      const lv = info[current - 1];
      chip.hidden = !lv;
      if (lv) {
        chipText.textContent = `Level ${lv.n} · ${lv.name}`;
        chipDot.style.background = lv.c;
      }
    };
    document.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
