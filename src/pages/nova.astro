---
// Draft home page: a supernova in aurora colours behind the whole page, with
// components taken from Aria's site (pill nav, corner chip, one statement per screen,
// a grouped index, FAQ, big closing call to action). Standalone: it does not use the
// Editorial layout, so the live home page and other pages are not affected.
import NovaSky from '../components/NovaSky.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
import { getSummaries, groupByLevel, issueUrl } from '../lib/lessons';

const lessons = await getSummaries();
const levels = groupByLevel(lessons);
const hours = Math.round(lessons.reduce((sum, l) => sum + l.minutes, 0) / 60);
const first = lessons[0];
const repoUrl = `https://github.com/${SITE.githubRepo}`;
const pad = (n: number) => String(n).padStart(2, '0');

// Aurora colours, one per level, in the same order as the remnant's palette.
const AURORA = ['#1ff2a0', '#29d0ff', '#5a6cff', '#a052ff', '#ff5cd6'];
const STATEMENTS = [
  'See how the web really works.',
  'Build features that stay safe.',
  'Ship it to real people.',
  'Keep it fast when it grows.',
  'See the whole system.',
];

const tools = [
  { href: '/start', title: 'Where should I start?', text: '15 questions that suggest your first lesson.' },
  { href: '/checklist', title: 'Pre-ship checklist', text: 'Every red flag from every lesson, in one list.' },
  { href: '/review', title: 'Review mode', text: 'A few quiz questions a day, so you remember.' },
  { href: '/glossary', title: 'Glossary', text: 'Every key term in plain English.' },
  { href: '/prompts', title: 'Prompt library', text: 'Questions to paste into your AI tool.' },
];

const faq = [
  {
    q: 'Do I need to know how to code?',
    a: 'No. Level 1 starts from zero. Each lesson explains a new word the first time it uses it.',
  },
  {
    q: 'Is it really free?',
    a: `Yes. All ${lessons.length} lessons are free, with no login and no paywall. The project is open source on GitHub.`,
  },
  {
    q: 'Where is my progress saved?',
    a: 'Only in your own browser. There are no accounts. If you clear your browser data, your progress is deleted too.',
  },
  {
    q: 'How long does it take?',
    a: `Each lesson takes 10 to 15 minutes and ends with a short quiz. All ${lessons.length} lessons take about ${hours} hours.`,
  },
  {
    q: 'I build with AI. Why learn this?',
    a: 'Your AI tool writes code fast, but it does not know your users, your costs or your risks. These lessons help you read what it makes and find the problems before your users do.',
  },
  {
    q: 'Can I skip ahead?',
    a: 'Yes. Take the short placement quiz, or open any level from the list above.',
  },
];
const levelInfo = levels.map((l, i) => ({ n: l.n, name: l.name, c: AURORA[i] }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#02030a" />
    <meta name="robots" content="noindex" />
    <title>Know what you're building · {SITE.name}</title>
    <meta name="description" content="Free, no-login lessons on the software fundamentals behind every app." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <NovaSky />

    <header class="nav">
      <a class="logo" href="/">before<span>/</span>you<span>/</span>ship</a>
      <nav aria-label="Main">
        <a href="/lessons">Lessons</a>
        <a href="/start">Where to start</a>
        <a href="/checklist">Checklist</a>
        <a href="/glossary">Glossary</a>
      </nav>
      {first && <a class="nav-btn" href={`/lessons/${first.slug}`}>Start learning</a>}
    </header>

    <main id="main">
      <section class="screen hero" aria-labelledby="hero-title">
        <div class="col">
          <p class="mono kicker">{lessons.length} lessons · {levels.length} levels · free · no login</p>
          <h1 id="hero-title">Know what you're building.</h1>
          <p class="lede">
            Short, plain-English lessons on how software really works. The web, databases, security, and running apps
            for real users. Made for people who build with AI.
          </p>
          <div class="actions">
            {first && <a class="btn btn-light" href={`/lessons/${first.slug}`}>Start with lesson 1</a>}
            <a class="btn" href="/start">Where should I start?</a>
          </div>
        </div>
        <p class="mono scroll-hint" aria-hidden="true">Scroll to watch it grow</p>
      </section>

      {
        levels.map((lv, i) => (
          <section class="screen step" data-nova-step aria-labelledby={`step-${lv.n}`}>
            <div class="col">
              <p class="mono kicker">
                <span class="dot" style={`background:${AURORA[i]}`} />
                Level {pad(lv.n)} / {pad(levels.length)} · {lv.name}
              </p>
              <h2 id={`step-${lv.n}`}>{STATEMENTS[i]}</h2>
              <p class="lede">{lv.blurb}</p>
              <a class="text-link" href={`/lessons#level-${lv.n}`}>
                {lv.lessons.length} lessons <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </section>
        ))
      }

      <div class="rest" data-nova-rest>
        <section class="block" aria-labelledby="index-title">
          <h2 id="index-title" class="big">{lessons.length} lessons.</h2>
          <p class="lede">Five levels, from your first website to systems at scale. Each lesson ends with a short quiz.</p>
          <div class="groups">
            {
              levels.map((lv, i) => (
                <details class="group" open={i === 0}>
                  <summary>
                    <span class="g-name">
                      <span class="dot" style={`background:${AURORA[i]}`} />
                      {lv.name}
                    </span>
                    <span class="mono g-count">{lv.lessons.length}</span>
                  </summary>
                  <ol>
                    {lv.lessons.map((l) => (
                      <li>
                        <a href={`/lessons/${l.slug}`}>
                          <span class="mono num">{pad(l.order)}</span>
                          <span>{l.title}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </details>
              ))
            }
          </div>
        </section>

        <section class="block" aria-labelledby="tools-title">
          <h2 id="tools-title" class="mid">Tools that come with it.</h2>
          <ul class="tools">
            {
              tools.map((t) => (
                <li>
                  <a href={t.href}>
                    <span class="t-title">
                      {t.title} <Icon name="arrow-right" size={16} />
                    </span>
                    <span class="t-text">{t.text}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="block" aria-labelledby="faq-title">
          <h2 id="faq-title" class="mid">Questions people ask.</h2>
          <div class="faq">
            {
              faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        <section class="cta" aria-labelledby="cta-title">
          <h2 id="cta-title" class="huge">Start before you ship.</h2>
          <div class="actions center">
            {first && <a class="btn btn-light" href={`/lessons/${first.slug}`}>Start with lesson 1</a>}
            <a class="btn" href="/lessons">See all lessons</a>
          </div>
        </section>

        <footer class="foot">
          <div class="foot-cols">
            <div>
              <p class="mono foot-h">Learn</p>
              <a href="/lessons">All lessons</a>
              <a href="/start">Where should I start?</a>
              <a href="/review">Review mode</a>
            </div>
            <div>
              <p class="mono foot-h">Tools</p>
              <a href="/checklist">Pre-ship checklist</a>
              <a href="/glossary">Glossary</a>
              <a href="/prompts">Prompt library</a>
            </div>
            <div>
              <p class="mono foot-h">Project</p>
              <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href={issueUrl(SITE.githubRepo)} target="_blank" rel="noopener noreferrer">Report a mistake</a>
            </div>
          </div>
          <p class="foot-note">
            <span class="logo">before<span>/</span>you<span>/</span>ship</span>
            <span>Free and open source. No login, no tracking cookies.</span>
          </p>
        </footer>
      </div>
    </main>

    <p class="mono chip" data-chip aria-hidden="true"><span class="dot" data-chip-dot></span><span data-chip-text></span></p>
    <script type="application/json" data-levels set:html={JSON.stringify(levelInfo)} />
    <script type="application/json" data-total set:html={JSON.stringify(lessons.length)} />
  </body>
</html>

<style is:global>
  :root {
    --ink: #f4f6ff;
    --soft: rgba(222, 228, 255, 0.7);
    --faint: rgba(222, 228, 255, 0.45);
    --line: rgba(255, 255, 255, 0.12);
    --glass: rgba(10, 12, 28, 0.5);
    --pad: clamp(20px, 5vw, 88px);
    --aurora: linear-gradient(90deg, #1ff2a0, #29d0ff, #5a6cff, #a052ff, #ff5cd6);
  }
  html {
    background: #02030a;
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    color: var(--ink);
    font-family: Geist, system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid #29d0ff;
    outline-offset: 3px;
    border-radius: 6px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    z-index: 100;
    padding: 8px 14px;
    background: #fff;
    color: #000;
    border-radius: 8px;
  }
  .mono {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: 0 0 10px currentColor;
  }

  /* Pill nav (Aria style): centred, frosted, one bright button. */
  .nav {
    position: fixed;
    top: 16px;
    left: 50%;
    z-index: 50;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 22px;
    width: max-content;
    max-width: calc(100vw - 24px);
    box-sizing: border-box;
    padding: 6px 6px 6px 20px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: rgba(8, 10, 24, 0.55);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }
  .logo {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo span {
    color: var(--faint);
  }
  .nav nav {
    display: flex;
    gap: 4px;
  }
  .nav nav a {
    padding: 6px 12px;
    border-radius: 99px;
    font-size: 0.88rem;
    color: var(--soft);
    text-decoration: none;
  }
  .nav nav a:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.08);
  }
  .nav-btn {
    padding: 8px 16px;
    border-radius: 99px;
    background: var(--ink);
    color: #05060f;
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .nav nav {
      display: none;
    }
    .nav {
      width: calc(100vw - 24px);
      justify-content: space-between;
    }
  }

  /* Screens: one statement each, text in the left column, the remnant on the right. */
  main {
    position: relative;
    z-index: 1;
  }
  .screen {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: 96px var(--pad) 64px;
    box-sizing: border-box;
  }
  .col {
    max-width: min(560px, 46vw);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--soft);
  }
  h1,
  h2 {
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0 0 22px;
    text-wrap: balance;
  }
  h1 {
    font-size: clamp(3rem, 6.6vw, 6.2rem);
  }
  .step h2 {
    font-size: clamp(2.4rem, 5vw, 4.6rem);
  }
  .lede {
    margin: 0 0 28px;
    max-width: 46ch;
    font-size: 1.12rem;
    color: var(--soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .actions.center {
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-weight: 500;
    text-decoration: none;
  }
  .btn:hover {
    border-color: rgba(255, 255, 255, 0.45);
  }
  .btn-light {
    background: var(--ink);
    border-color: var(--ink);
    color: #05060f;
  }
  .btn-light:hover {
    box-shadow: 0 0 0 4px rgba(41, 208, 255, 0.25);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 2px;
  }
  .text-link:hover {
    border-color: var(--ink);
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    margin: 0;
    transform: translateX(-50%);
    color: var(--faint);
    animation: hint 2.4s ease-in-out infinite;
  }
  @keyframes hint {
    50% {
      transform: translate(-50%, 6px);
      opacity: 0.5;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
    }
  }
  /* Phones: the remnant sits in the top half, the text at the bottom. */
  @media (max-aspect-ratio: 23/20) {
    .screen {
      align-items: flex-end;
      padding-bottom: 72px;
    }
    .col {
      max-width: none;
      padding: 22px 0 0;
      background: linear-gradient(180deg, transparent, rgba(2, 3, 10, 0.75) 30%);
      box-shadow: 0 0 0 100vmax transparent;
    }
    .scroll-hint {
      display: none;
    }
  }

  /* Below the story: the sky dims and the sections sit on top. */
  .rest {
    padding: 12vh var(--pad) 0;
  }
  .block {
    max-width: 1160px;
    margin: 0 auto 18vh;
  }
  .big {
    font-size: clamp(3.4rem, 9vw, 8rem);
  }
  .mid {
    font-size: clamp(2.2rem, 4.6vw, 3.8rem);
  }
  .huge {
    font-size: clamp(3rem, 9vw, 8.4rem);
    text-align: center;
  }
  .groups {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .group {
    border-bottom: 1px solid var(--line);
  }
  .group summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
  }
  .group summary::-webkit-details-marker {
    display: none;
  }
  .g-name {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .g-count {
    font-size: 0.95rem;
    color: var(--faint);
  }
  .group summary:hover .g-count,
  .group[open] .g-count {
    color: var(--ink);
  }
  .group ol {
    columns: 2 320px;
    column-gap: 40px;
    margin: 0;
    padding: 0 4px 26px;
    list-style: none;
  }
  .group li {
    break-inside: avoid;
  }
  .group li a {
    display: flex;
    gap: 14px;
    padding: 7px 0;
    color: var(--soft);
    text-decoration: none;
  }
  .group li a:hover {
    color: var(--ink);
  }
  .num {
    flex: none;
    padding-top: 3px;
    color: var(--faint);
  }
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .tools a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    box-sizing: border-box;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    text-decoration: none;
  }
  .tools a:hover {
    border-color: rgba(255, 255, 255, 0.3);
  }
  .t-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-weight: 500;
  }
  .t-text {
    color: var(--soft);
    font-size: 0.95rem;
  }
  .faq {
    margin-top: 36px;
    border-top: 1px solid var(--line);
  }
  .faq details {
    border-bottom: 1px solid var(--line);
  }
  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 4px;
    cursor: pointer;
    list-style: none;
    font-size: 1.15rem;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: 'Geist Mono', monospace;
    color: var(--faint);
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq p {
    margin: 0;
    padding: 0 4px 22px;
    max-width: 62ch;
    color: var(--soft);
  }
  .cta {
    max-width: 1160px;
    margin: 0 auto;
    padding: 10vh 0 18vh;
  }
  .foot {
    max-width: 1160px;
    margin: 0 auto;
    padding: 40px 0 120px;
    border-top: 1px solid var(--line);
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 28px;
  }
  .foot-cols div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .foot-cols a {
    color: var(--soft);
    text-decoration: none;
  }
  .foot-cols a:hover {
    color: var(--ink);
  }
  .foot-h {
    margin: 0 0 6px;
    color: var(--faint);
  }
  .foot-note {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin: 48px 0 0;
    color: var(--faint);
    font-size: 0.9rem;
  }

  /* Corner chip (Aria's clock): the current level, or your progress. */
  .chip {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: rgba(8, 10, 24, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--soft);
    font-size: 0.72rem;
  }
</style>

<script>
  import { getCompleted } from '../lib/progress';

  const chip = document.querySelector<HTMLElement>('[data-chip]')!;
  const text = document.querySelector<HTMLElement>('[data-chip-text]')!;
  const dot = document.querySelector<HTMLElement>('[data-chip-dot]')!;
  const levels: { n: number; name: string; c: string }[] = JSON.parse(
    document.querySelector('[data-levels]')!.textContent || '[]',
  );
  const total = Number(document.querySelector('[data-total]')!.textContent || 0);
  const done = getCompleted().length;
  const pad = (n: number) => String(n).padStart(2, '0');

  const show = (level: number) => {
    const lv = levels[level - 1];
    if (lv) {
      text.textContent = `Level ${pad(lv.n)} / ${pad(levels.length)} · ${lv.name}`;
      dot.style.background = lv.c;
      dot.style.color = lv.c;
    } else {
      text.textContent = done ? `${done} of ${total} lessons done` : `${total} lessons · free`;
      dot.style.background = '#f4f6ff';
      dot.style.color = '#29d0ff';
    }
    chip.hidden = false;
  };
  show(0);
  window.addEventListener('nova:level', (e) => show((e as CustomEvent<number>).detail));
</script>
