---
// Glossary: every "Key terms" entry from every lesson, A–Z, linked to the lesson that teaches it.
import Reading from '../layouts/Reading.astro';
import Icon from '../components/Icon.astro';
import { getLessons } from '../lib/lessons';
import { extract, glossary, inline, plain } from '../lib/extract';

const lessons = await getLessons();
const entries = glossary(extract(lessons).terms);
const letters = [...new Set(entries.map((e) => e.term[0].toUpperCase()))].filter((c) => /[A-Z]/.test(c));
const letterOf = (t: string) => (/[A-Z]/i.test(t[0]) ? t[0].toUpperCase() : '#');
---

<Reading title="Glossary" width="wide" description="Every key term from every lesson, in plain English, with a link to the lesson that explains it.">
  <header>
    <h1 class="page-title">Glossary</h1>
    <p class="page-intro">Every key term from every lesson, in plain English. Each one links to the lesson that teaches it.</p>
    <p class="mt-4 text-sm">{entries.length} terms</p>

    <label class="mt-10 flex max-w-[520px] items-center gap-3 rounded-full border border-line bg-white/[0.03] px-5 focus-within:border-white/50">
      <Icon name="search" size={18} class="shrink-0" />
      <input
        type="search"
        placeholder="Find a term: cache, IDOR, mutex…"
        autocomplete="off"
        data-gl-filter
        aria-label="Filter terms"
        class="h-12 w-full bg-transparent text-white outline-none placeholder:text-white"
      />
    </label>

    <nav class="mt-6 flex flex-wrap gap-1" aria-label="Jump to letter">
      {letters.map((c) => <a href={`#letter-${c}`} class="rounded-full px-2.5 py-1 text-sm hover:bg-white/8">{c}</a>)}
    </nav>
  </header>

  <section class="mt-10">
    <p class="py-6" data-gl-empty hidden>No terms match that.</p>
    <dl class="gl border-t border-line">
      {
        entries.map((e, i) => (
          <div
            class="scroll-mt-24 border-b border-line py-6"
            id={i === entries.findIndex((x) => letterOf(x.term) === letterOf(e.term)) ? `letter-${letterOf(e.term)}` : undefined}
            data-gl={`${e.term} ${plain(e.def)}`.toLowerCase()}
          >
            <dt class="h3">{e.term}</dt>
            <dd class="mt-2 leading-relaxed">
              <span set:html={inline(e.def)} />
              <span class="mt-2 block text-sm">
                Taught in{' '}
                <a href={`/lessons/${e.slug}`} class="underline decoration-white/30 underline-offset-4 hover:decoration-white">
                  {e.order}. {e.title}
                </a>
                {e.also.length > 0 && <> · also in {e.also.length} other {e.also.length === 1 ? 'lesson' : 'lessons'}</>}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Reading>

<style>
  .gl :global(code) {
    padding: 0.12em 0.38em;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.09);
    font-size: 0.88em;
  }
  .gl :global(a:not([class])) {
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-underline-offset: 3px;
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-gl-filter]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-gl]')];
  const empty = document.querySelector<HTMLElement>('[data-gl-empty]')!;
  input.addEventListener('input', () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const hit = words.every((w) => item.dataset.gl!.includes(w));
      item.hidden = !hit;
      if (hit) shown++;
    }
    empty.hidden = shown > 0;
  });
</script>
