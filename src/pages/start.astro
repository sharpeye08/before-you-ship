---
// "Where should I start?" placement test: 3 questions per level, taken from the lessons'
// own quizzes, plus an "I'm not sure" option so guessing doesn't skew the result.
import Editorial from '../layouts/Editorial.astro';
import Icon from '../components/Icon.astro';
import { getLessons } from '../lib/lessons';
import { inline } from '../lib/extract';
import { LEVELS } from '../config';

// [lesson slug, quiz question index]; chosen because each question makes sense on its own.
const PICKS: [string, number][] = [
  ['website-errors', 0],
  ['what-is-a-database', 4],
  ['git-as-an-undo-button', 0],
  ['logged-in-doesnt-mean-allowed', 0],
  ['sql-injection', 5],
  ['cors', 4],
  ['dev-staging-production', 0],
  ['timeouts-and-retries', 0],
  ['reading-code-you-didnt-write', 0],
  ['database-indexes', 2],
  ['charged-twice', 1],
  ['caching', 1],
  ['circuit-breakers', 1],
  ['outbox-pattern', 0],
  ['event-driven-architecture', 4],
];

const lessons = await getLessons();
const bySlug = new Map(lessons.map((l) => [l.id, l]));
const questions = PICKS.flatMap(([slug, i]) => {
  const l = bySlug.get(slug);
  const q = l?.data.quiz[i];
  return l && q ? [{ slug, level: l.data.level, q }] : [];
});
const firstOfLevel = Object.fromEntries(
  LEVELS.map((lv) => {
    const first = lessons.find((l) => l.data.level === lv.n);
    return [lv.n, first ? { slug: first.id, title: first.data.title, order: first.data.order } : null];
  }),
);
---

<Editorial title="Where should I start?" description="Answer 15 quick questions and get a recommended starting lesson.">
  <header class="tool-head">
    <p class="kicker"><Icon name="compass" size={16} /> Placement test</p>
    <h1>Where should I start?</h1>
    <p class="muted">
      15 questions, 3 from each level. Pick "I'm not sure" instead of guessing; it gives a better answer. Takes about 5
      minutes, and nothing is saved or sent anywhere.
    </p>
  </header>

  <form class="tool-section glass placement" data-placement data-first={JSON.stringify(firstOfLevel)}>
    <ol class="p-list">
      {
        questions.map((item, qi) => (
          <li class="p-q" data-level={item.level}>
            <p class="p-question" set:html={inline(item.q.question)} />
            <div class="p-options">
              {item.q.options.map((o, oi) => (
                <label>
                  <input type="radio" name={`q${qi}`} value={o.correct ? 'right' : 'wrong'} required />
                  <span set:html={inline(o.text)} />
                </label>
              ))}
              <label class="unsure">
                <input type="radio" name={`q${qi}`} value="unsure" />
                <span>I'm not sure</span>
              </label>
            </div>
          </li>
        ))
      }
    </ol>
    <button type="submit" class="btn btn-accent">See my starting point</button>
  </form>

  <section class="tool-section glass result" data-result hidden aria-live="polite"></section>
</Editorial>

<style>
  .p-list {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    counter-reset: q;
    display: grid;
    gap: 22px;
  }
  .p-q {
    counter-increment: q;
  }
  .p-question {
    margin: 0 0 10px;
    font-weight: 600;
    line-height: 1.5;
  }
  .p-question::before {
    content: counter(q) '. ';
    color: var(--muted);
  }
  .p-options {
    display: grid;
    gap: 6px;
  }
  .p-options label {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--row);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-soft);
  }
  .p-options label:has(input:checked) {
    background: var(--glass-hover);
    color: var(--text);
    outline: 1px solid var(--border-strong);
  }
  .p-options input {
    margin-top: 4px;
    accent-color: var(--accent);
    flex: none;
  }
  .p-options .unsure {
    font-style: italic;
  }
  .result :global(h2) {
    margin: 0 0 6px;
  }
  .result :global(.bars) {
    display: grid;
    gap: 10px;
    margin: 18px 0 22px;
  }
  .result :global(.bar-label) {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: var(--text-soft);
    margin-bottom: 6px;
  }
  :global(.placement code),
  :global(.result code) {
    font-family: var(--mono);
    font-size: 0.88em;
    background: rgba(255, 255, 255, 0.07);
    padding: 0.1em 0.35em;
    border-radius: 5px;
  }
</style>

<script>
  import { LEVELS } from '../config';

  const form = document.querySelector<HTMLFormElement>('[data-placement]')!;
  const result = document.querySelector<HTMLElement>('[data-result]')!;
  const first: Record<string, { slug: string; title: string; order: number } | null> = JSON.parse(form.dataset.first || '{}');

  // Shuffle the real options; keep "I'm not sure" last.
  form.querySelectorAll('.p-options').forEach((box) => {
    const unsure = box.querySelector('.unsure')!;
    const opts = [...box.querySelectorAll('label:not(.unsure)')];
    for (let i = opts.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [opts[i], opts[j]] = [opts[j], opts[i]];
    }
    opts.forEach((o) => box.insertBefore(o, unsure));
  });

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const score: Record<number, { right: number; total: number }> = {};
    form.querySelectorAll<HTMLElement>('.p-q').forEach((q) => {
      const level = Number(q.dataset.level);
      score[level] ??= { right: 0, total: 0 };
      score[level].total++;
      if (q.querySelector<HTMLInputElement>('input:checked')?.value === 'right') score[level].right++;
    });

    // Start at the first level where fewer than 2 of 3 answers were right.
    const startLevel = LEVELS.find((lv) => (score[lv.n]?.right ?? 0) < 2)?.n;
    const lesson = startLevel ? first[startLevel] : first[LEVELS[LEVELS.length - 1].n];
    const levelName = (n: number) => LEVELS.find((l) => l.n === n)?.name ?? '';

    const bars = LEVELS.map((lv) => {
      const s = score[lv.n] ?? { right: 0, total: 0 };
      const pct = s.total ? (s.right / s.total) * 100 : 0;
      return `<div><div class="bar-label"><span>Level ${lv.n} · ${esc(lv.name)}</span><span>${s.right} / ${s.total}</span></div>
        <div class="progress-track"><div class="progress-fill" style="width:${pct}%"></div></div></div>`;
    }).join('');

    const headline = startLevel
      ? `Start at Level ${startLevel}: ${esc(levelName(startLevel))}`
      : 'You know a lot already. Try Level 5';
    const advice = startLevel && startLevel > 1
      ? `You can probably skim Levels 1–${startLevel - 1}. Use each lesson's quiz to check yourself, and read the lessons where you get questions wrong.`
      : startLevel === 1
        ? 'Begin at the start. Each lesson builds on the one before it.'
        : 'You got at least 2 of 3 right on every level. The last level covers how bigger systems stay reliable.';

    result.innerHTML = `
      <p class="kicker">Your result</p>
      <h2>${headline}</h2>
      <p class="muted">${advice}</p>
      <div class="bars">${bars}</div>
      ${lesson ? `<a class="btn btn-accent" href="/lessons/${lesson.slug}">Start with lesson ${lesson.order}: ${esc(lesson.title)}</a>` : ''}
      <a class="btn" href="/lessons">See all lessons</a>`;
    result.hidden = false;
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
