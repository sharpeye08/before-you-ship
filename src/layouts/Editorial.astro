---
// Editorial layout for lesson pages: black frame, big headline, calm reading column.
// Defines the same CSS variable names as the old design, so shared components
// (Quiz) keep working without changes.
import '../styles/editorial-tools.css';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
import { issueUrl } from '../lib/lessons';

interface Props {
  title: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const pageTitle = `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const repoUrl = `https://github.com/${SITE.githubRepo}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0c0c" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {
      SITE.cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cfBeaconToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame">
      <header class="top">
        <a class="logo" href="/">before<span>/</span>you<span>/</span>ship</a>
        <nav aria-label="Main">
          <a class="hide-sm nav-link" href="/lessons">All lessons <Icon name="arrow-right" size={15} /></a>
          <details class="menu">
            <summary>Menu <span class="dot" aria-hidden="true"></span></summary>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/lessons">All lessons</a></li>
              <li><a href="/start">Where should I start?</a></li>
              <li><a href="/checklist">Pre-ship checklist</a></li>
              <li><a href="/review">Review mode</a></li>
              <li><a href="/glossary">Glossary</a></li>
              <li><a href="/prompts">Prompt library</a></li>
              <li><a href={repoUrl} target="_blank" rel="noopener noreferrer" class="nav-link">GitHub <Icon name="external" size={14} /></a></li>
            </ul>
          </details>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="foot">
        <span>Free and open source. No login, no tracking cookies.</span>
        <a href={issueUrl(SITE.githubRepo)} target="_blank" rel="noopener noreferrer">Found a mistake? Tell us on GitHub</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0c0c0c;
    --frame: #050505;
    --text: #f2f2f2;
    --text-soft: #c9c9c9;
    --muted: #8a8a8a;
    --line: rgba(255, 255, 255, 0.12);
    --border: rgba(255, 255, 255, 0.12);
    --border-strong: rgba(255, 255, 255, 0.24);
    --row: rgba(255, 255, 255, 0.04);
    --glass-hover: rgba(255, 255, 255, 0.08);
    --accent: #e5484d;
    --accent-soft: rgba(229, 72, 77, 0.14);
    --accent-text: #ff9a9e;
    --good: #3dd68c;
    --good-soft: rgba(61, 214, 140, 0.12);
    --radius-sm: 12px;
    --mono: ui-monospace, 'SFMono-Regular', 'Cascadia Code', Menlo, Consolas, monospace;
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  [hidden] {
    display: none !important;
  }
  body {
    margin: 0;
    overflow-x: clip;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  :focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .skip-link {
    position: absolute;
    left: -999px;
    top: 8px;
    padding: 8px 12px;
    background: var(--text);
    color: #111;
    z-index: 100;
  }
  .skip-link:focus {
    left: 8px;
  }
  .muted {
    color: var(--muted);
  }
  :root {
    --pad-x: clamp(18px, 5vw, 88px);
    --pad-top: 28px;
    --top-gap: 56px;
    --top-h: 54px;
  }
  .frame {
    max-width: none;
    margin: 0;
    padding: var(--pad-top) var(--pad-x) 56px;
    background-color: var(--frame);
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 6px 6px;
    min-height: 100vh;
  }
  .top {
    position: sticky;
    top: 14px;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--top-h);
    margin: 0 auto var(--top-gap);
    max-width: 1100px;
    padding: 0 10px 0 22px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 99px;
    background: rgba(18, 18, 18, 0.55);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .top nav > a,
  .menu summary {
    padding: 8px 14px;
    border-radius: 99px;
  }
  .top nav > a:hover,
  .menu summary:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  main {
    max-width: 1440px;
    margin: 0 auto;
  }
  .logo {
    text-decoration: none;
    font-family: 'Inter Tight', Inter, sans-serif;
    font-weight: 600;
    font-size: 1.05rem;
  }
  .logo span {
    color: var(--muted);
  }
  .top nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 0.95rem;
  }
  .top nav > a {
    text-decoration: none;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .menu {
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 8px;
    border-radius: 50%;
    background: var(--text);
  }
  .menu[open] .dot {
    background: var(--accent);
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    z-index: 30;
    min-width: 220px;
    list-style: none;
    margin: 0;
    padding: 8px;
    background: #141414;
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }
  .menu li a {
    display: block;
    padding: 9px 12px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .menu li a:hover {
    background: var(--glass-hover);
  }
  .foot {
    position: relative;
    z-index: 1;
    background-color: var(--frame);
    box-shadow: 0 0 0 100vmax var(--frame);
    clip-path: inset(0 -100vmax -100vmax);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 72px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 99px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    cursor: pointer;
  }
  .btn:hover {
    background: var(--glass-hover);
  }
  .btn-accent {
    background: var(--text);
    border-color: var(--text);
    color: #111;
  }
  .btn-accent:hover {
    background: #fff;
  }
  .btn-done {
    background: var(--good-soft);
    border-color: rgba(61, 214, 140, 0.4);
    color: var(--good);
  }
  .glass {
    background: transparent;
  }
  @media (max-width: 860px) {
    :root {
      --pad-top: 20px;
      --top-gap: 32px;
    }
    .frame {
      padding-bottom: 40px;
    }
    .hide-sm {
      display: none;
    }
  }
</style>
