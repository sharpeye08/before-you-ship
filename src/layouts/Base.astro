---
import '../styles/global.css';
import NightScene from '../components/NightScene.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
import { issueUrl } from '../lib/lessons';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'lessons' | 'checklist' | 'review' | 'glossary' | 'prompts' | 'start' | 'none';
}

const { title, description = SITE.description, active = 'none' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const repoUrl = `https://github.com/${SITE.githubRepo}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07090e" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      SITE.cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cfBeaconToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <NightScene />

    <nav class="sidebar glass" aria-label="Main">
      <a href="/" class:list={['side-btn', { active: active === 'home' }]} aria-label="Home" title="Home">
        <Icon name="home" />
      </a>
      <a
        href="/lessons"
        class:list={['side-btn', { active: active === 'lessons' }]}
        aria-label="All lessons"
        title="All lessons"
      >
        <Icon name="book" />
      </a>
      <a href="/checklist" class:list={['side-btn', { active: active === 'checklist' }]} aria-label="Pre-ship checklist" title="Pre-ship checklist">
        <Icon name="list-check" />
      </a>
      <a href="/review" class:list={['side-btn', { active: active === 'review' }]} aria-label="Review mode" title="Review mode">
        <Icon name="brain" />
      </a>
      <a href="/glossary" class:list={['side-btn', { active: active === 'glossary' }]} aria-label="Glossary" title="Glossary">
        <Icon name="glossary" />
      </a>
      <a href="/prompts" class:list={['side-btn', { active: active === 'prompts' }]} aria-label="Prompt library" title="Prompt library">
        <Icon name="sparkles" />
      </a>
      <span class="side-divider" aria-hidden="true"></span>
      <a
        href={repoUrl}
        class="side-btn"
        aria-label="GitHub repository"
        title="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="github" />
      </a>
    </nav>

    <div class="page">
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <p class="pill glass"><Icon name="sparkles" size={16} /> Stay curious, keep learning.</p>
        <p class="footer-note">
          Free and open source. No login, no tracking cookies. Found a mistake?
          <a href={issueUrl(SITE.githubRepo)} target="_blank" rel="noopener noreferrer">Tell us on GitHub</a>.
        </p>
      </footer>
    </div>
  </body>
</html>
