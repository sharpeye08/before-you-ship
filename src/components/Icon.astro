---
// Icons come from Lucide (@lucide/astro). The names below are the ones the site uses;
// each maps to a Lucide icon. Lucide has no brand logos, so "github" uses external-link.
import House from '@lucide/astro/icons/house';
import BookOpen from '@lucide/astro/icons/book-open';
import BookA from '@lucide/astro/icons/book-a';
import Brain from '@lucide/astro/icons/brain';
import Check from '@lucide/astro/icons/check';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Circle from '@lucide/astro/icons/circle';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Clock from '@lucide/astro/icons/clock';
import Compass from '@lucide/astro/icons/compass';
import Copy from '@lucide/astro/icons/copy';
import ExternalLink from '@lucide/astro/icons/external-link';
import Flag from '@lucide/astro/icons/flag';
import ListChecks from '@lucide/astro/icons/list-checks';
import RefreshCw from '@lucide/astro/icons/refresh-cw';
import Search from '@lucide/astro/icons/search';
import Sparkles from '@lucide/astro/icons/sparkles';

const ICONS = {
  home: House,
  book: BookOpen,
  glossary: BookA,
  brain: Brain,
  check: Check,
  'check-circle': CircleCheck,
  circle: Circle,
  'chevron-right': ChevronRight,
  'arrow-left': ArrowLeft,
  'arrow-right': ArrowRight,
  clock: Clock,
  compass: Compass,
  copy: Copy,
  external: ExternalLink,
  github: ExternalLink,
  flag: Flag,
  'list-check': ListChecks,
  refresh: RefreshCw,
  search: Search,
  sparkles: Sparkles,
} as const;

interface Props {
  name: keyof typeof ICONS;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;
const Lucide = ICONS[name];
---

<Lucide
  size={size}
  stroke-width={1.75}
  class={`icon ${className}`}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
/>
