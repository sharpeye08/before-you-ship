---
// Home page hero art: a white beam enters a plain prism and leaves as a spectrum in the
// five level colours. Drawn on a canvas as halftone dots (each grid cell is a dot whose
// size follows its brightness, with ordered dithering), in the style of halftone ASCII art.
// Written from scratch for this site; nothing is loaded from outside.
---

<figure class="prism" aria-hidden="true">
  <canvas data-prism></canvas>
</figure>

<style>
  .prism {
    margin: 0;
    position: relative;
    aspect-ratio: 200 / 90;
    border-radius: 18px;
    overflow: hidden;
    background: #000;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const COLS = 200;
  const ROWS = 90;
  const FPS = 15;
  // Spectrum, top to bottom: the five level colours.
  const BANDS = ['#e98da4', '#f08a4b', '#f2c94c', '#1f9d6b', '#4f6bd8'];
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => v / 16);

  // Scene geometry in grid cells.
  const A = { x: 95, y: 12 }; // apex
  const L = { x: 58, y: 76 }; // base left
  const R = { x: 132, y: 76 }; // base right
  const leftFaceX = (y: number) => L.x + ((L.y - y) / (L.y - A.y)) * (A.x - L.x);
  const rightFaceX = (y: number) => A.x + ((y - A.y) / (R.y - A.y)) * (R.x - A.x);
  const IN = { x: leftFaceX(50), y: 50 };
  const OUT = { x: rightFaceX(46), y: 46 };
  const START = { x: -2, y: 61 };
  const TOP_ANGLE = Math.atan2(28 - OUT.y, COLS - OUT.x);
  const BOTTOM_ANGLE = Math.atan2(86 - OUT.y, COLS - OUT.x);

  function distToSegment(px: number, py: number, a: { x: number; y: number }, b: { x: number; y: number }) {
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const t = Math.max(0, Math.min(1, ((px - a.x) * dx + (py - a.y) * dy) / (dx * dx + dy * dy)));
    return Math.hypot(px - (a.x + t * dx), py - (a.y + t * dy));
  }
  const insideTriangle = (x: number, y: number) => y > A.y && y < L.y && x > leftFaceX(y) && x < rightFaceX(y);
  const hash = (x: number, y: number) => {
    const s = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
    return s - Math.floor(s);
  };

  // Returns [brightness 0..1, colour] for one cell at time t (seconds).
  function shade(x: number, y: number, t: number): [number, string] {
    const pulse = 0.85 + 0.15 * Math.sin(t * 2.2);

    // Prism edges.
    const edge = Math.min(distToSegment(x, y, A, L), distToSegment(x, y, A, R), distToSegment(x, y, L, R));
    if (edge < 1.6) return [0.95 * Math.exp(-((edge / 0.9) ** 2)), '#ffffff'];

    // Incoming white beam, with dust sparkles along it.
    if (x <= IN.x + 1) {
      const d = distToSegment(x, y, START, IN);
      let b = Math.exp(-((d / 1.6) ** 2)) * pulse;
      if (d < 6 && hash(x, y) > 0.985) b = Math.max(b, 0.4 + 0.4 * Math.sin(t * 6 + x));
      if (b > 0.03) return [b, '#ffffff'];
    }

    if (insideTriangle(x, y)) {
      const d = distToSegment(x, y, IN, OUT);
      const beam = Math.exp(-((d / 1.4) ** 2)) * 0.7 * pulse;
      return [Math.max(beam, 0.05), '#ffffff'];
    }

    // Spectrum fanning out to the right.
    if (x > OUT.x) {
      const angle = Math.atan2(y - OUT.y, x - OUT.x);
      const f = (angle - TOP_ANGLE) / (BOTTOM_ANGLE - TOP_ANGLE);
      if (f > -0.04 && f < 1.04) {
        const band = Math.min(BANDS.length - 1, Math.max(0, Math.floor(f * BANDS.length)));
        const edgeFade = Math.min(1, Math.min(f + 0.04, 1.04 - f) * 12);
        const shimmer = 0.75 + 0.25 * Math.sin(t * 3 + x * 0.15 + band);
        const near = Math.min(1, 0.55 + (x - OUT.x) / 60);
        return [edgeFade * shimmer * near * pulse, BANDS[band]];
      }
    }

    // Floor line under the prism, and faint background dust.
    if (Math.abs(y - (L.y + 1)) < 0.6 && x > 30 && x < 175) return [0.18, '#9c9c9c'];
    if (hash(x, y) > 0.996) return [0.25 + 0.2 * Math.sin(t + x), '#7e7e7e'];
    return [0, '#000'];
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-prism]')) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cell = 4;
    let visible = true;
    let last = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(w * (ROWS / COLS) * dpr);
      cell = canvas.width / COLS;
    };

    const draw = (t: number) => {
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      for (let y = 0; y < ROWS; y++) {
        for (let x = 0; x < COLS; x++) {
          const [b, color] = shade(x, y, t);
          if (b <= 0) continue;
          // Ordered dithering: dim cells only draw where the Bayer threshold allows.
          if (b < 0.35 && b < BAYER[(y % 4) * 4 + (x % 4)] * 0.35) continue;
          const r = (cell / 2) * Math.min(1, Math.sqrt(b) * 1.05);
          ctx.globalAlpha = 0.35 + 0.65 * Math.min(1, b);
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc((x + 0.5) * cell, (y + 0.5) * cell, Math.max(r, cell * 0.12), 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };

    const loop = (now: number) => {
      if (visible && !document.hidden && now - last > 1000 / FPS) {
        last = now;
        draw(now / 1000);
      }
      requestAnimationFrame(loop);
    };

    resize();
    draw(1.2);
    new ResizeObserver(() => {
      resize();
      draw(performance.now() / 1000);
    }).observe(canvas);
    if (!reduce) {
      new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(canvas);
      requestAnimationFrame(loop);
    }
  }
</script>
