---
// Full-screen hero background: a white beam enters a plain prism and leaves as a
// spectrum in the five level colours. Drawn on a canvas as halftone dots (each grid
// cell is a dot whose size follows its brightness, with ordered dithering).
// The grid adapts to any screen shape. Written from scratch; nothing loads from outside.
// With `scroll`, the canvas is fixed behind the page and each level's colour lights up
// as the reader scrolls past that level (the page sets window.__prismProgress, 0 to 5).
interface Props {
  scroll?: boolean;
}
const { scroll = false } = Astro.props;
---

<div class:list={['prism', { fixed: scroll }]} aria-hidden="true">
  <canvas data-prism data-scroll={scroll ? 'true' : undefined}></canvas>
</div>

<style>
  .prism {
    position: absolute;
    inset: 0;
    background: #000;
    overflow: hidden;
  }
  .prism.fixed {
    position: fixed;
    z-index: 0;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const ROWS = 96;
  const FPS = 15;
  // Spectrum, top to bottom: the five level colours.
  const BANDS = ['#e98da4', '#f08a4b', '#f2c94c', '#1f9d6b', '#4f6bd8'];
  const BAND_LEVEL = [4, 5, 1, 3, 2]; // pink L4, orange L5, yellow L1, green L3, blue L2
  let reveal = [1, 1, 1, 1, 1];
  const progress = () => (window as unknown as { __prismProgress?: number }).__prismProgress ?? 0;
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => v / 16);
  type P = { x: number; y: number };

  function scene(cols: number) {
    const narrow = cols < 120; // phones in portrait use a smaller prism
    const cx = cols * 0.5; // always centred
    const A = { x: cx, y: ROWS * (narrow ? 0.12 : 0.1) };
    const baseY = ROWS * (narrow ? 0.4 : 0.56);
    const half = (baseY - A.y) * 0.58;
    const L = { x: cx - half, y: baseY };
    const R = { x: cx + half, y: baseY };
    const leftFaceX = (y: number) => L.x + ((L.y - y) / (L.y - A.y)) * (A.x - L.x);
    const rightFaceX = (y: number) => A.x + ((y - A.y) / (R.y - A.y)) * (R.x - A.x);
    const inY = A.y + (baseY - A.y) * 0.6;
    const outY = A.y + (baseY - A.y) * 0.53;
    const IN = { x: leftFaceX(inY), y: inY };
    const OUT = { x: rightFaceX(outY), y: outY };
    const START = { x: -2, y: inY + (baseY - A.y) * 0.18 };
    const top = Math.atan2(ROWS * (narrow ? 0.08 : 0.04) - OUT.y, cols - OUT.x);
    const bottom = Math.atan2(ROWS * (narrow ? 0.5 : 0.72) - OUT.y, cols - OUT.x);
    return { A, L, R, IN, OUT, START, top, bottom, leftFaceX, rightFaceX, baseY };
  }

  function distToSegment(px: number, py: number, a: P, b: P) {
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const t = Math.max(0, Math.min(1, ((px - a.x) * dx + (py - a.y) * dy) / (dx * dx + dy * dy)));
    return Math.hypot(px - (a.x + t * dx), py - (a.y + t * dy));
  }
  const hash = (x: number, y: number) => {
    const s = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
    return s - Math.floor(s);
  };

  function shade(g: ReturnType<typeof scene>, cols: number, x: number, y: number, t: number): [number, string] {
    const pulse = 0.85 + 0.15 * Math.sin(t * 2.2);
    const edge = Math.min(distToSegment(x, y, g.A, g.L), distToSegment(x, y, g.A, g.R), distToSegment(x, y, g.L, g.R));
    if (edge < 1.6) return [0.95 * Math.exp(-((edge / 0.9) ** 2)), '#ffffff'];

    if (x <= g.IN.x + 1) {
      const d = distToSegment(x, y, g.START, g.IN);
      let b = Math.exp(-((d / 1.7) ** 2)) * pulse;
      if (d < 6 && hash(x, y) > 0.985) b = Math.max(b, 0.4 + 0.4 * Math.sin(t * 6 + x));
      if (b > 0.03) return [b, '#ffffff'];
    }

    const inside = y > g.A.y && y < g.L.y && x > g.leftFaceX(y) && x < g.rightFaceX(y);
    if (inside) {
      const d = distToSegment(x, y, g.IN, g.OUT);
      return [Math.max(Math.exp(-((d / 1.4) ** 2)) * 0.7 * pulse, 0.05), '#ffffff'];
    }

    if (x > g.OUT.x) {
      const angle = Math.atan2(y - g.OUT.y, x - g.OUT.x);
      const f = (angle - g.top) / (g.bottom - g.top);
      if (f > -0.04 && f < 1.04) {
        const band = Math.min(BANDS.length - 1, Math.max(0, Math.floor(f * BANDS.length)));
        if (reveal[band] <= 0) return [0, '#000'];
        const edgeFade = Math.min(1, Math.min(f + 0.04, 1.04 - f) * 12);
        const shimmer = 0.75 + 0.25 * Math.sin(t * 3 + x * 0.15 + band);
        const near = Math.min(1, 0.55 + (x - g.OUT.x) / 60);
        return [edgeFade * shimmer * near * pulse * reveal[band], BANDS[band]];
      }
    }

    if (Math.abs(y - (g.baseY + 1)) < 0.6 && x > cols * 0.04 && x < cols * 0.96) return [0.16, '#9c9c9c'];
    if (hash(x, y) > 0.996) return [0.25 + 0.2 * Math.sin(t + x), '#7e7e7e'];
    return [0, '#000'];
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-prism]')) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cell = 8;
    let cols = 160;
    let g = scene(cols);
    let visible = true;
    let last = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      cell = canvas.height / ROWS;
      cols = Math.ceil(canvas.width / cell);
      g = scene(cols);
    };

    const scrollMode = canvas.dataset.scroll === 'true';
    const draw = (t: number) => {
      reveal = scrollMode
        ? BAND_LEVEL.map((lv) => Math.max(0, Math.min(1, progress() - (lv - 1))))
        : [1, 1, 1, 1, 1];
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      for (let y = 0; y < ROWS; y++) {
        for (let x = 0; x < cols; x++) {
          const [b, color] = shade(g, cols, x, y, t);
          if (b <= 0) continue;
          if (b < 0.35 && b < BAYER[(y % 4) * 4 + (x % 4)] * 0.35) continue;
          const r = (cell / 2) * Math.min(1, Math.sqrt(b) * 1.05);
          ctx.globalAlpha = 0.35 + 0.65 * Math.min(1, b);
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc((x + 0.5) * cell, (y + 0.5) * cell, Math.max(r, cell * 0.12), 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };

    const loop = (now: number) => {
      if (visible && !document.hidden && now - last > 1000 / FPS) {
        last = now;
        draw(now / 1000);
      }
      requestAnimationFrame(loop);
    };

    resize();
    draw(1.2);
    new ResizeObserver(() => {
      resize();
      draw(performance.now() / 1000);
    }).observe(canvas);
    if (scrollMode) {
      // Still frames for reduced motion still follow the scroll.
      window.addEventListener('prism:progress', () => reduce && draw(1.2));
    }
    if (!reduce) {
      new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(canvas);
      requestAnimationFrame(loop);
    }
  }
</script>
