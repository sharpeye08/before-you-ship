---
// Lesson search. "dropdown" shows matching lessons under the box (home page).
// "filter" hides non-matching rows on the page (lesson list), using [data-search] on each row.
import Icon from './Icon.astro';
import type { LessonSummary } from '../lib/lessons';

interface Props {
  lessons: LessonSummary[];
  mode?: 'dropdown' | 'filter';
  placeholder?: string;
}

const { lessons, mode = 'dropdown', placeholder = 'Find a lesson: DNS, git, login, CORS…' } = Astro.props;
const index = lessons.map((l) => ({
  s: l.slug,
  t: l.title,
  c: l.concepts.join(', '),
  n: l.order,
  lv: l.levelName,
}));
---

<div class="relative" data-search-root data-mode={mode}>
  <label class="flex h-12 items-center gap-3 rounded-full border border-line bg-white/[0.03] px-5 transition-colors focus-within:border-white/50 hover:border-white/30">
    <Icon name="search" size={18} />
    <span class="sr-only">Search lessons</span>
    <input
      type="search"
      class="h-full min-w-0 flex-1 bg-transparent text-white outline-none placeholder:text-white"
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      aria-controls={mode === 'dropdown' ? 'search-results' : undefined}
    />
    <span class="hidden flex-none rounded-md border border-line px-2 py-0.5 text-xs sm:inline" data-kbd>Ctrl K</span>
  </label>
  {
    mode === 'dropdown' && (
      <ul
        id="search-results"
        class="search-results absolute inset-x-0 top-full z-40 mt-2 overflow-hidden rounded-2xl border border-line bg-[#0e0f11] py-2"
        role="listbox"
        hidden
      />
    )
  }
  <script type="application/json" data-search-index set:html={JSON.stringify(index)} />
</div>

<script>
  type Entry = { s: string; t: string; c: string; n: number; lv: string };

  const norm = (s: string) => s.toLowerCase().normalize('NFKD');

  function matches(entry: Entry, words: string[]) {
    const hay = norm(`${entry.t} ${entry.c} ${entry.lv}`);
    return words.every((w) => hay.includes(w));
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-search-root]')) {
    const input = root.querySelector('input')!;
    const mode = root.dataset.mode;
    const index: Entry[] = JSON.parse(root.querySelector('[data-search-index]')!.textContent || '[]');
    const kbd = root.querySelector<HTMLElement>('[data-kbd]');
    if (kbd && /Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = '⌘ K';

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });

    if (mode === 'filter') {
      const params = new URLSearchParams(location.search);
      if (params.get('q')) input.value = params.get('q')!;
      const apply = () => {
        const words = norm(input.value).split(/\s+/).filter(Boolean);
        let shown = 0;
        document.querySelectorAll<HTMLElement>('[data-search]').forEach((row) => {
          const hit = words.every((w) => norm(row.dataset.search || '').includes(w));
          row.hidden = !hit;
          if (hit) shown++;
        });
        document.querySelectorAll<HTMLElement>('[data-level-section]').forEach((sec) => {
          sec.hidden = !sec.querySelector('[data-search]:not([hidden])');
        });
        const empty = document.querySelector<HTMLElement>('[data-search-empty]');
        if (empty) empty.hidden = shown > 0;
      };
      input.addEventListener('input', apply);
      apply();
      continue;
    }

    const list = root.querySelector<HTMLUListElement>('.search-results')!;
    let active = -1;

    const render = () => {
      const words = norm(input.value).split(/\s+/).filter(Boolean);
      if (!words.length) {
        list.hidden = true;
        return;
      }
      const hits = index.filter((e) => matches(e, words)).slice(0, 8);
      active = hits.length ? 0 : -1;
      list.innerHTML = '';
      if (!hits.length) {
        const li = document.createElement('li');
        li.className = 'px-5 py-3 text-sm';
        li.textContent = 'No lessons match that yet.';
        list.append(li);
      }
      hits.forEach((h, i) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/lessons/${h.s}`;
        a.setAttribute('role', 'option');
        a.setAttribute('aria-selected', String(i === active));
        a.className = 'flex items-center gap-4 px-5 py-3 hover:bg-white/8 aria-selected:bg-white/8';
        const num = document.createElement('span');
        num.className = 'grid size-8 flex-none place-items-center rounded-full border border-line text-sm font-semibold tabular-nums';
        num.textContent = String(h.n);
        const text = document.createElement('span');
        text.className = 'min-w-0 flex-1';
        const title = document.createElement('span');
        title.className = 'block font-medium';
        title.textContent = h.t;
        const sub = document.createElement('span');
        sub.className = 'mt-0.5 block truncate text-sm';
        sub.textContent = `${h.lv} · ${h.c}`;
        text.append(title, sub);
        a.append(num, text);
        li.append(a);
        list.append(li);
      });
      list.hidden = false;
    };

    const select = (i: number) => {
      const links = [...list.querySelectorAll('a')];
      if (!links.length) return;
      active = (i + links.length) % links.length;
      links.forEach((a, j) => a.setAttribute('aria-selected', String(j === active)));
    };

    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      const links = [...list.querySelectorAll('a')];
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        select(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        select(active - 1);
      } else if (e.key === 'Enter' && links[active]) {
        e.preventDefault();
        location.href = links[active].href;
      } else if (e.key === 'Escape') {
        list.hidden = true;
      }
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) list.hidden = true;
    });
  }
</script>
