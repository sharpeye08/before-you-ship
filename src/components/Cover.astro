---
// Generated lesson cover in a flat, grainy illustration style. Shapes and placement are
// seeded from the lesson slug, so every lesson gets its own stable cover; the main color
// comes from the lesson's level. Replace with real illustrations later if wanted.
import { LEVEL_COLORS } from '../config';

interface Props {
  slug: string;
  order: number;
  level: number;
  levelName: string;
}
const { slug, order, level, levelName } = Astro.props;

const PALETTE = ['#f2c94c', '#4f6bd8', '#1f9d6b', '#e98da4', '#f08a4b', '#151515'];

let seed = [...slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7) || 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

const main = LEVEL_COLORS[level] ?? '#f2c94c';
const shapes = Array.from({ length: 6 }, (_, i) => {
  const color = i < 2 ? main : PALETTE[Math.floor(rand() * PALETTE.length)];
  const kind = rand() < 0.35 ? 'circle' : 'card';
  const x = 430 + rand() * 520;
  const y = 30 + rand() * 260;
  const w = 110 + rand() * 90;
  const h = 140 + rand() * 90;
  const rot = Math.round((rand() - 0.5) * 30);
  return { color, kind, x, y, w, h, rot };
});
---

<figure class="cover" aria-hidden="true">
  <svg viewBox="0 0 1000 380" preserveAspectRatio="xMinYMid slice">
    <defs>
      <pattern id={`grain-${slug}`} width="6" height="6" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="0.6" fill="#000" opacity="0.09" />
        <circle cx="4" cy="4" r="0.5" fill="#000" opacity="0.06" />
      </pattern>
    </defs>
    <rect width="1000" height="380" fill="#f1e6cf" />
    {
      shapes.map((s) =>
        s.kind === 'circle' ? (
          <circle cx={s.x} cy={s.y + s.w / 2} r={s.w / 2} fill={s.color} />
        ) : (
          <rect
            x={s.x - s.w / 2}
            y={s.y}
            width={s.w}
            height={s.h}
            rx="12"
            fill={s.color}
            transform={`rotate(${s.rot} ${s.x} ${s.y + s.h / 2})`}
          />
        ),
      )
    }
    <text x="60" y="300" font-family="'Inter Tight', Inter, sans-serif" font-weight="600" font-size="220" fill="#151515" letter-spacing="-12">{String(order).padStart(2, '0')}</text>
    <rect x="64" y="56" width={`Level ${level} · ${levelName}`.length * 9.4 + 40} height="34" rx="17" fill="#151515" />
    <text x="84" y="79" font-family="Inter, sans-serif" font-size="16" font-weight="500" fill="#f1e6cf">Level {level} · {levelName}</text>
    <rect width="1000" height="380" fill={`url(#grain-${slug})`} />
  </svg>
</figure>

<style>
  .cover {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 1000 / 380;
    background: #f1e6cf;
  }
  .cover svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 860px) {
    .cover {
      aspect-ratio: 16 / 9;
      border-radius: 14px;
    }
  }
</style>
