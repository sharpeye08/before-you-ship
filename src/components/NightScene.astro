---
// Decorative night-sky background: stars, moon, mountains and a lake.
// Generated at build time with a fixed seed, so it is identical on every page.
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

const stars = Array.from({ length: 140 }, () => ({
  x: +(rand() * 1440).toFixed(1),
  y: +(rand() * 520).toFixed(1),
  r: +(rand() * 0.9 + 0.3).toFixed(2),
  o: +(rand() * 0.6 + 0.25).toFixed(2),
}));

// Jagged ridge line across the width.
function ridge(base: number, amp: number, step: number) {
  let d = `M0 900 L0 ${base}`;
  for (let x = 0; x <= 1440; x += step) {
    const y = base - rand() * amp - (Math.sin(x / 210) + 1) * amp * 0.35;
    d += ` L${x} ${y.toFixed(1)}`;
  }
  return d + ' L1440 900 Z';
}

const far = ridge(560, 150, 60);
const mid = ridge(610, 110, 45);
const near = ridge(660, 70, 35);
---

<div class="scene" aria-hidden="true">
  <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#05070c" />
        <stop offset="0.55" stop-color="#0d1220" />
        <stop offset="0.75" stop-color="#121a2b" />
        <stop offset="1" stop-color="#06080d" />
      </linearGradient>
      <radialGradient id="moonGlow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#e8ecf5" stop-opacity="0.35" />
        <stop offset="1" stop-color="#e8ecf5" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="lake" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#101727" />
        <stop offset="1" stop-color="#04060a" />
      </linearGradient>
      <linearGradient id="far" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a3346" />
        <stop offset="1" stop-color="#121826" />
      </linearGradient>
      <linearGradient id="mid" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1a2030" />
        <stop offset="1" stop-color="#0b0f18" />
      </linearGradient>
    </defs>
    <rect width="1440" height="900" fill="url(#sky)" />
    <g fill="#ffffff">
      {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} />)}
    </g>
    <circle cx="1080" cy="170" r="70" fill="url(#moonGlow)" />
    <path d="M1092 150a24 24 0 1 0 6 36 20 20 0 1 1-6-36Z" fill="#e9edf5" opacity="0.9" />
    <path d={far} fill="url(#far)" opacity="0.85" />
    <path d={mid} fill="url(#mid)" />
    <path d={near} fill="#070a10" />
    <rect y="700" width="1440" height="200" fill="url(#lake)" />
    <rect x="1050" y="712" width="60" height="160" fill="#e9edf5" opacity="0.05" />
  </svg>
  <div class="scene-shade"></div>
</div>
