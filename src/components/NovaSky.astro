---
// Fixed background for the /nova page: a star field with a supernova in aurora colours.
// Drawn with a WebGL shader at half resolution, then ordered-dithered into a fine pixel
// grid (the texture idea comes from Aria's dithered sky).
//
// Story: the hero shows a plain sky with one star. When the reader scrolls, the star
// flares and explodes. Each element marked `data-nova-step` grows the remnant as the
// reader scrolls past it, and sends out a shockwave ring.
// The element marked `data-nova-rest` dims the sky so text below it stays readable.
// The current step goes out as a `nova:level` event (detail: 0 to 5).
---

<div class="nova" aria-hidden="true">
  <canvas data-nova></canvas>
</div>

<style>
  .nova {
    position: fixed;
    inset: 0;
    z-index: 0;
    /* Shown if WebGL is not available. */
    background:
      radial-gradient(circle at 68% 48%, rgba(120, 90, 255, 0.35), transparent 22%),
      radial-gradient(circle at 64% 44%, rgba(40, 220, 200, 0.25), transparent 30%),
      #02030a;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
</style>

<script>
  const PIX = 2; // CSS px per rendered pixel (the dither grain)
  const FPS = 30;

  const VERT = `attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }`;
  const FRAG = `
precision highp float;
uniform vec2 uRes; uniform vec2 uCenter; uniform vec2 uPar;
uniform float uTime; uniform float uAge; uniform float uDim; uniform float uPulse; uniform float uScale;

float hash(vec2 p){ p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
float noise(vec2 p){
  vec2 i = floor(p); vec2 f = fract(p); vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}
float fbm(vec2 p){
  float v = 0.0; float a = 0.5; mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
  for (int i = 0; i < 5; i++){ v += a * noise(p); p = m * p; a *= 0.5; }
  return v;
}
// Aurora palette: green, cyan, blue, violet, magenta.
vec3 aurora(float x){
  x = clamp(x, 0.0, 1.0) * 4.0;
  vec3 c0 = vec3(0.12, 0.95, 0.62); vec3 c1 = vec3(0.16, 0.82, 1.0); vec3 c2 = vec3(0.32, 0.42, 1.0);
  vec3 c3 = vec3(0.64, 0.32, 1.0); vec3 c4 = vec3(1.0, 0.36, 0.82);
  if (x < 1.0) return mix(c0, c1, x);
  if (x < 2.0) return mix(c1, c2, x - 1.0);
  if (x < 3.0) return mix(c2, c3, x - 2.0);
  return mix(c3, c4, x - 3.0);
}
float bayer2(vec2 a){ a = floor(a); return fract(a.x / 2.0 + a.y * a.y * 0.75); }
float bayer4(vec2 a){ return bayer2(0.5 * a) * 0.25 + bayer2(a); }

vec3 stars(vec2 uv, float scale, float t, float dens){
  vec2 g = uv * scale; vec2 id = floor(g); vec2 f = fract(g) - 0.5;
  float h = hash(id);
  if (h < dens) return vec3(0.0);
  vec2 off = (vec2(hash(id + 3.1), hash(id + 7.7)) - 0.5) * 0.6;
  float d = length(f - off);
  float tw = 0.65 + 0.35 * sin(t * (0.8 + h * 2.5) + h * 60.0);
  float b = smoothstep(0.24, 0.0, d) * tw * ((h - dens) / (1.0 - dens));
  vec3 gold = vec3(1.0, 0.72, 0.38); vec3 blue = vec3(0.75, 0.85, 1.0);
  return mix(gold, blue, step(0.62, hash(id + 11.0))) * b;
}

void main(){
  vec2 frag = gl_FragCoord.xy;
  vec2 p = (frag - 0.5 * uRes) / uRes.y;
  float t = uTime;
  vec3 col = vec3(0.004, 0.006, 0.02);

  // Faint aurora haze across the whole sky.
  vec2 hp = p * 1.3 + uPar * 0.02;
  float hz = fbm(hp * 1.5 + vec2(t * 0.006, 0.0));
  col += aurora(fbm(hp * 0.8 + 4.0)) * pow(hz, 3.0) * 0.12;

  // Three star layers; nearer layers move more with the pointer.
  vec3 st = stars(p + uPar * 0.004, 70.0, t, 0.90) * 0.95;
  st += stars(p + uPar * 0.008 + 3.3, 140.0, t, 0.87) * 0.6;
  st += stars(p + uPar * 0.012 + 9.1, 260.0, t, 0.85) * 0.4;

  // Supernova remnant.
  vec2 q0 = (p - uCenter) / uScale;
  float age = uAge;
  float grow = smoothstep(0.03, 0.16, age);
  float R = mix(0.015, 0.40, pow(age, 0.8));
  vec2 q = q0 / R;
  float r = length(q);
  vec2 dir = q / max(r, 1e-4);
  float shellR = 0.78 + 0.45 * fbm(dir * 1.4 + vec2(3.1, 1.7));
  float d = r / shellR;
  vec2 w = vec2(fbm(q * 1.6 + vec2(0.0, t * 0.03)), fbm(q * 1.6 + vec2(5.2, -t * 0.025)));
  float n = fbm(q * 2.2 + w * 1.7);
  float rg = 1.0 - abs(fbm(q * 3.0 + w * 2.4 + vec2(t * 0.01, 0.0)) * 2.0 - 1.0);
  rg = pow(rg, 4.0);
  float body = smoothstep(1.05, 0.55, d);
  float rim = smoothstep(1.1, 0.92, d) * smoothstep(0.45, 0.9, d);
  float dens = grow * (body * (0.28 + 1.5 * n * n) * (0.5 + 0.5 * smoothstep(0.0, 0.85, d)) + rim * (0.3 + rg));
  float hc = fbm(q * 1.1 + w * 1.3 + 7.3);
  vec3 base = aurora((hc - 0.3) * 2.2 + 0.25 * sin(t * 0.05));
  vec3 rimCol = mix(vec3(1.0, 0.55, 0.28), vec3(1.0, 0.38, 0.78), n);
  float fade = 1.0 - 0.88 * uDim; // the remnant fades behind the text sections
  vec3 neb = (base * dens * 1.1 + rimCol * rim * rg * grow * 0.9) * fade;
  col += st * (1.0 - clamp(dens * 0.7, 0.0, 0.85)) + neb;

  // The star at the centre: bright before the explosion, a flash, then a small core.
  float rc = length(q0);
  float pre = 1.0 - smoothstep(0.0, 0.08, age);
  float flash = exp(-pow((age - 0.06) / 0.05, 2.0));
  float coreI = fade * 0.9 * pre * (0.85 + 0.15 * sin(t * 2.0)) + fade * (3.0 * flash + 0.3);
  vec3 coreCol = vec3(0.82, 0.92, 1.0);
  col += coreCol * coreI * (0.0005 / (rc * rc + 0.0005));
  float sp = exp(-abs(q0.x) * 600.0) * exp(-abs(q0.y) * 10.0) + exp(-abs(q0.y) * 600.0) * exp(-abs(q0.x) * 10.0);
  col += coreCol * sp * coreI * 0.35;

  // Shockwave ring when a new level is reached.
  // It follows the remnant's uneven outline and fades as it travels.
  float ringD = 0.55 + uPulse * 0.75;
  float ring = exp(-pow((d - ringD) / (0.025 + 0.02 * uPulse), 2.0)) * exp(-uPulse * 1.4);
  col += mix(vec3(0.6, 1.0, 0.9), vec3(0.85, 0.7, 1.0), n) * ring * (0.6 + rg) * fade;

  col *= mix(1.0, 0.7, uDim);
  col = 1.0 - exp(-col * 1.25);
  float L = 7.0;
  col = floor(col * L + bayer4(frag)) / L;
  gl_FragColor = vec4(col, 1.0);
}`;

  const canvas = document.querySelector<HTMLCanvasElement>('[data-nova]');
  const gl = canvas?.getContext('webgl', { antialias: false, alpha: false, preserveDrawingBuffer: false });

  function compile(g: WebGLRenderingContext, type: number, src: string) {
    const s = g.createShader(type)!;
    g.shaderSource(s, src);
    g.compileShader(s);
    if (!g.getShaderParameter(s, g.COMPILE_STATUS)) throw new Error(g.getShaderInfoLog(s) || 'shader');
    return s;
  }

  if (canvas && gl) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl, gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl, gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const u = (name: string) => gl.getUniformLocation(prog, name);
    const U = {
      res: u('uRes'), center: u('uCenter'), par: u('uPar'), time: u('uTime'),
      age: u('uAge'), dim: u('uDim'), pulse: u('uPulse'), scale: u('uScale'),
    };

    const steps = [...document.querySelectorAll<HTMLElement>('[data-nova-step]')];
    const rest = document.querySelector<HTMLElement>('[data-nova-rest]');
    let wide = true;
    let age = 0;
    let dim = 0;
    let level = 0;
    let pulseAt = -99;
    let last = 0;
    const par = { x: 0, y: 0, tx: 0, ty: 0 };

    const resize = () => {
      canvas.width = Math.ceil(window.innerWidth / PIX);
      canvas.height = Math.ceil(window.innerHeight / PIX);
      gl.viewport(0, 0, canvas.width, canvas.height);
      wide = window.innerWidth / window.innerHeight > 1.15;
    };

    // Scroll position → age of the supernova (0 = the star before it explodes, 1 = full size),
    // dimming, and current level.
    const read = () => {
      const vh = window.innerHeight;
      let s = 0;
      let current = 0;
      steps.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        s += Math.min(1, Math.max(0, (vh * 0.75 - r.top) / (vh * 0.5)));
        if (r.top < vh * 0.55) current = i + 1;
      });
      const restTop = rest ? rest.getBoundingClientRect().top : vh * 9;
      return {
        age: s / Math.max(1, steps.length),
        dim: Math.min(1, Math.max(0, (vh - restTop) / (vh * 0.7))),
        level: rest && restTop < vh * 0.5 ? 0 : current,
      };
    };

    const frame = (now: number) => {
      const t = now / 1000;
      const dt = Math.min(0.1, last ? (now - last) / 1000 : 0.016);
      const target = read();
      age = reduce ? target.age : age + (target.age - age) * Math.min(1, dt * 2.4);
      dim = reduce ? target.dim : dim + (target.dim - dim) * Math.min(1, dt * 4);
      if (target.level !== level) {
        if (target.level > level) pulseAt = t;
        level = target.level;
        window.dispatchEvent(new CustomEvent('nova:level', { detail: level }));
      }
      par.x += (par.tx - par.x) * Math.min(1, dt * 3);
      par.y += (par.ty - par.y) * Math.min(1, dt * 3);

      gl.uniform2f(U.res, canvas.width, canvas.height);
      gl.uniform2f(U.center, wide ? 0.3 : 0, wide ? 0.0 : 0.2);
      gl.uniform1f(U.scale, wide ? 1 : 0.62);
      gl.uniform2f(U.par, par.x, par.y);
      gl.uniform1f(U.time, reduce ? 12 : t);
      gl.uniform1f(U.age, age);
      gl.uniform1f(U.dim, dim);
      gl.uniform1f(U.pulse, reduce ? 99 : t - pulseAt);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      last = now;
    };

    resize();
    window.addEventListener('resize', () => {
      resize();
      frame(performance.now());
    });
    window.addEventListener(
      'pointermove',
      (e) => {
        par.tx = (e.clientX / window.innerWidth - 0.5) * 2;
        par.ty = -(e.clientY / window.innerHeight - 0.5) * 2;
      },
      { passive: true },
    );
    if (reduce) {
      frame(performance.now());
      document.addEventListener('scroll', () => frame(performance.now()), { passive: true });
    } else {
      const loop = (now: number) => {
        if (!document.hidden && now - last >= 1000 / FPS - 2) frame(now);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
